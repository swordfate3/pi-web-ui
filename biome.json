{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "components.json",
      "e2e/**/*.ts",
      "extensions/**/*.ts",
      "package.json",
      "public/**/*.js",
      "public/**/*.json",
      "src/**/*.css",
      "src/**/*.ts",
      "src/**/*.tsx",
      "tests/web-connection.test.ts",
      "tests/pi-client-recovery.test.ts",
      "tests/connection-lifecycle.test.ts",
      "tests/file-downloads.test.ts",
      "tests/git-preview-budget.test.ts",
      "tests/live-transport.test.ts",
      "tests/markdown-math.test.ts",
      "tests/markdown-math-components.test.mjs",
      "tests/register-tsx.mjs",
      "tests/ordinary-browser-commands.test.ts",
      "tests/browser-mutation-lifecycle.test.ts",
      "tests/terminal-prompt.test.ts",
      "tests/terminal-prompt-integration.test.ts",
      "tests/message-revision.test.ts",
      "tests/message-revision-client.test.ts",
      "tests/message-versions.test.ts",
      "tests/message-versions-client.test.ts",
      "tests/message-versions-scope.test.ts",
      "tests/queued-prompt.test.ts",
      "tests/history-store.test.ts",
      "tests/file-download-store.test.ts",
      "tests/file-links.test.ts",
      "tests/workspace-uploads.test.ts",
      "tests/chunked-uploads.test.ts",
      "tests/workspace-upload-client.test.ts",
      "tests/incremental-sha256.test.ts",
      "tests/scoped-submit.test.ts",
      "tests/session-usage.test.ts",
      "tests/usage-stats-client.test.ts",
      "tests/whale-pet.test.ts",
      "tests/whale-assets.test.ts",
      "tests/session-registration.test.ts",
      "tests/connection-path.test.ts",
      "tests/service-worker-scope.test.ts",
      "tests/remote-access.test.ts",
      "tests/software-metadata.test.ts",
      "tests/remote-access-draft-state.test.ts",
      "tsconfig.json",
      "tsconfig.connection.json",
      "vite.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
