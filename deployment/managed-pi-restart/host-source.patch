+"""Tests for synchronizing CC Switch's Pi model configuration."""
+import json
+import os
+from pathlib import Path
+import select
+import subprocess
+import tempfile
+import time
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ENTRYPOINT = ROOT / "pi-entrypoint"
+DOCKERFILE = ROOT / "Dockerfile"
+
+
+class EntrypointModelSyncTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="pi-model-sync-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.models_dir = self.root / "cc-switch-models"
+        self.models_dir.mkdir()
+        self.pi_agent_dir = self.root / "pi-agent"
+        self.pi_agent_dir.mkdir()
+        self.fake_bin = self.root / "bin"
+        self.fake_bin.mkdir()
+        self.launch_log = self.root / "pi-launches.jsonl"
+        fake_pi = self.fake_bin / "pi"
+        fake_pi.write_text(
+            "#!/usr/bin/env python3\n"
+            "import json,os,sys\n"
+            "with open(os.environ['PI_TEST_LAUNCH_LOG'], 'a') as stream:\n"
+            "    stream.write(json.dumps({'argv': sys.argv[1:], "
+            "'token': os.environ.get('PI_RUNTIME_CHILD_TOKEN')}) + '\\n')\n"
+        )
+        fake_pi.chmod(0o755)
+        self.env = os.environ.copy()
+        self.env.update(
+            HOME=str(self.root / "home"),
+            PI_CODING_AGENT_DIR=str(self.pi_agent_dir),
+            PI_CC_SWITCH_MODELS_DIR=str(self.models_dir),
+            PI_TEST_LAUNCH_LOG=str(self.launch_log),
+            PATH=f"{self.fake_bin}:{self.env['PATH']}",
+        )
+
+    def run_entrypoint(self, *args, tty=False, check=True):
+        command = ["bash", str(ENTRYPOINT), *args]
+        if not tty:
+            return subprocess.run(command, env=self.env, capture_output=True,
+                                  text=True, check=check)
+        master, slave = os.openpty()
+        process = subprocess.Popen(command, env=self.env, stdin=slave, stdout=slave,
+                                   stderr=subprocess.PIPE)
+        os.close(slave)
+        output = bytearray()
+        try:
+            deadline = time.monotonic() + 5
+            while time.monotonic() < deadline:
+                readable, _, _ = select.select([master], [], [], 0.05)
+                if readable:
+                    try:
+                        chunk = os.read(master, 8192)
+                    except OSError:
+                        break
+                    if not chunk:
+                        break
+                    output.extend(chunk)
+                elif process.poll() is not None:
+                    break
+            _, error = process.communicate(timeout=5)
+            if check and process.returncode != 0:
+                self.fail(f"entrypoint failed {process.returncode}: {error.decode()}")
+            return subprocess.CompletedProcess(command, process.returncode,
+                                               output.decode(errors="replace"),
+                                               error.decode(errors="replace"))
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.communicate(timeout=5)
+            os.close(master)
+
+    def launches(self):
+        if not self.launch_log.exists():
+            return []
+        return [json.loads(line) for line in self.launch_log.read_text().splitlines()]
+
+    def write_json(self, path, value):
+        path.write_text(json.dumps(value))
+
+    def read_json(self, path):
+        return json.loads(path.read_text())
+
+    def test_external_valid_config_overwrites_persistent_pi_config(self):
+        target = self.pi_agent_dir / "models.json"
+        self.write_json(target, {"source": "pi-home"})
+        external = self.models_dir / "models.json"
+        self.write_json(external, {"source": "cc-switch"})
+
+        self.run_entrypoint()
+
+        self.assertEqual(self.read_json(target), {"source": "cc-switch"})
+
+    def test_missing_external_config_is_initialized_from_persistent_pi_config(self):
+        target = self.pi_agent_dir / "models.json"
+        self.write_json(target, {"source": "existing-volume"})
+
+        self.run_entrypoint()
+
+        self.assertEqual(self.read_json(self.models_dir / "models.json"),
+                         {"source": "existing-volume"})
+        self.assertEqual(self.read_json(target), {"source": "existing-volume"})
+
+    def test_invalid_external_config_does_not_replace_persistent_pi_config(self):
+        target = self.pi_agent_dir / "models.json"
+        self.write_json(target, {"source": "safe-existing-config"})
+        (self.models_dir / "models.json").write_text('{ invalid json')
+
+        result = self.run_entrypoint()
+
+        self.assertEqual(self.read_json(target), {"source": "safe-existing-config"})
+        self.assertIn("invalid CC Switch models.json", result.stderr)
+
+    def test_reordered_help_and_version_forms_remain_direct(self):
+        self.env["PI_RUNTIME_RUN_ID"] = "1" * 32
+        cases = [
+            ("--offline", "--version"),
+            ("--provider", "test-provider", "--model", "test-model", "--help"),
+        ]
+        for args in cases:
+            with self.subTest(args=args):
+                self.launch_log.unlink(missing_ok=True)
+                self.run_entrypoint(*args, tty=True)
+                self.assertEqual(len(self.launches()), 1)
+                self.assertIsNone(self.launches()[0]["token"])
+
+    def test_delimited_direct_only_text_stays_managed(self):
+        self.env.update(
+            PI_RUNTIME_RUN_ID="1" * 32,
+            PI_RUNTIME_DIR=str(self.root / "runtime"),
+        )
+
+        self.run_entrypoint("--", "--no-session", tty=True)
+
+        self.assertEqual(len(self.launches()), 1)
+        self.assertRegex(self.launches()[0]["token"], r"^[0-9a-f]{64}$")
+
+    def test_dockerfile_uses_gate_allowlisted_absolute_entrypoint_and_fixed_helper(self):
+        dockerfile = DOCKERFILE.read_text()
+        self.assertIn('ENTRYPOINT ["/usr/local/bin/pi-entrypoint"]', dockerfile)
+        self.assertIn(
+            "COPY runtime/pi_model_sync.py /usr/local/lib/pi-runtime/pi_model_sync.py",
+            dockerfile,
+        )
+        self.assertIn(
+            "COPY runtime/pi_launch_policy.py /usr/local/lib/pi-runtime/pi_launch_policy.py",
+            dockerfile,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
