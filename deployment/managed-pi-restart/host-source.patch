+class PiSupervisorTests(unittest.TestCase):
+    def test_normal_child_exit_is_returned_without_respawn(self):
+        harness = SupervisorHarness(self, normal_exit=True, normal_exit_code=23)
+        command = [
+            sys.executable,
+            str(SUPERVISOR),
+            "--stop-timeout", "0.2",
+            "--start-timeout", "0.2",
+            "--",
+            str(harness.fake_pi),
+        ]
+        completed = subprocess.run(command, cwd=harness.cwd, env=harness.env,
+                                   capture_output=True, timeout=5)
+        self.assertEqual(completed.returncode, 23, completed.stderr.decode())
+        self.assertEqual(len(harness.spawns()), 1)
+
+    def test_restart_preserves_exact_session_and_leaf_without_replaying_prompt(self):
+        marker = self.root_marker = Path(tempfile.gettempdir()) / f"pi-supervisor-shell-{os.getpid()}"
+        marker.unlink(missing_ok=True)
+        self.addCleanup(marker.unlink, missing_ok=True)
+        metacharacters = f"model value; touch {marker}"
+        harness = SupervisorHarness(self).start(
+            "--system-prompt", metacharacters,
+            "--offline",
+            "--provider", "obsolete-provider",
+            "--model", "obsolete-model",
+            "--thinking", "low",
+            "--continue",
+            "--session", "old-session.jsonl",
+            "original prompt must not replay",
+        )
+        harness.wait_for(lambda: harness.status()["runtime_id"] == "runtime-old")
+
+        completed, accepted = harness.restart_request()
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertTrue(accepted["ok"], accepted)
+        self.assertEqual(accepted["result"]["operation_id"], OPERATION_ID)
+        result = harness.wait_operation("succeeded")
+
+        operation = result["operation"]
+        self.assertEqual(operation["stage"], "complete")
+        self.assertEqual(operation["old_runtime_id"], "runtime-old")
+        self.assertEqual(operation["new_runtime_id"], "runtime-new")
+        self.assertEqual(operation["session_id"], "session-exact")
+        self.assertEqual(operation["leaf_id"], "leaf-exact")
+        self.assertEqual(operation["old_version"], "1.0.0")
+        self.assertEqual(operation["expected_version"], "2.0.0")
+        self.assertEqual(operation["new_version"], "2.0.0")
+        spawns = harness.spawns()
+        self.assertEqual(len(spawns), 2)
+        self.assertRegex(spawns[0]["token"], r"^[0-9a-f]{64}$")
+        self.assertRegex(spawns[1]["token"], r"^[0-9a-f]{64}$")
+        self.assertNotEqual(spawns[0]["token"], spawns[1]["token"])
+        self.assertEqual(
+            spawns[1]["argv"],
+            [
+                "--system-prompt", metacharacters,
+                "--offline",
+                "--provider", "test-provider",
+                "--model", "test-model",
+                "--thinking", "high",
+                "--session", str(harness.session_file),
+            ],
+        )
+        self.assertFalse(marker.exists())
+
+    def test_stale_identity_is_rejected_without_preparing_or_respawning(self):
+        harness = SupervisorHarness(self).start()
+        harness.wait_for(lambda: harness.status()["runtime_id"] == "runtime-old")
+
+        completed, reply = harness.restart_request(runtime_id="runtime-stale")
+
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertTrue(reply["ok"], reply)
+        self.assertEqual(reply["result"]["stage"], "checking")
+        result = harness.wait_operation("failed")
+        self.assertEqual(result["operation"]["stage"], "checking_rejected")
+        self.assertEqual(len(harness.spawns()), 1)
+        self.assertFalse(harness.signal_log.exists())
+
