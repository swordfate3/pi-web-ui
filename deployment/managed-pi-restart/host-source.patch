+FROM node:24-bookworm-slim
+
+RUN apt-get update \
+    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+       bash \
+       git \
+       openssh-client \
+       curl \
+       ripgrep \
+       fd-find \
+       ca-certificates \
+       python3 \
+       python3-venv \
+       build-essential \
+    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
+    && rm -rf /var/lib/apt/lists/*
+
+ENV PYTHON=/usr/bin/python3
+
+# Keep the Hugging Face CLI and library in an image-owned virtual environment.
+# The runtime container remains a non-root node user; only the image build
+# writes under /opt and /usr/local.
+RUN python3 -m venv /opt/huggingface \
+    && /opt/huggingface/bin/python -m pip install --no-cache-dir --no-compile huggingface_hub \
+    && ln -s /opt/huggingface/bin/hf /usr/local/bin/hf \
+    && printf '%s\n' 'export PATH=/opt/huggingface/bin:$PATH' > /etc/profile.d/huggingface.sh \
+    && chmod 644 /etc/profile.d/huggingface.sh
+
+COPY pi-entrypoint /usr/local/bin/pi-entrypoint
+COPY runtime/pi_supervisor.py /usr/local/lib/pi-runtime/pi_supervisor.py
+COPY --chown=0:0 --chmod=644 runtime/pi_stdin_guard.mjs /usr/local/lib/pi-runtime/pi_stdin_guard.mjs
+COPY runtime/pi_model_sync.py /usr/local/lib/pi-runtime/pi_model_sync.py
+COPY runtime/pi_launch_policy.py /usr/local/lib/pi-runtime/pi_launch_policy.py
+COPY runtime/pi-session-control /usr/local/bin/pi-session-control
+RUN chmod 755 /usr/local/bin/pi-entrypoint \
+    /usr/local/lib/pi-runtime/pi_supervisor.py \
+    /usr/local/lib/pi-runtime/pi_model_sync.py \
+    /usr/local/lib/pi-runtime/pi_launch_policy.py \
+    /usr/local/bin/pi-session-control
