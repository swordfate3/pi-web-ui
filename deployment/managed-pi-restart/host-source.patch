+import sys
+import time
+
+config = json.loads(Path(os.environ["FAKE_PI_CONFIG"]).read_text())
+if sys.argv[1:] == ["--version"]:
+    time.sleep(config.get("version_delay", 0))
+    print(config.get("installed_version", "2.0.0"))
+    raise SystemExit(0)
+
+state_path = Path(os.environ["FAKE_PI_STATE"])
+try:
+    spawn = int(state_path.read_text())
+except FileNotFoundError:
+    spawn = 0
+state_path.write_text(str(spawn + 1))
+
+tokens = config.get("tokens", [])
+token = os.environ.get("PI_RUNTIME_CHILD_TOKEN", "")
+runtime_id = config.get("runtime_ids", ["runtime-old", "runtime-new"])[spawn]
+version = config.get("versions", ["1.0.0", "2.0.0"])[spawn]
+models = None
+if config.get("models_file"):
+    models = json.loads(Path(config["models_file"]).read_text())
+snapshot = {
+    "run_id": os.environ.get("PI_RUNTIME_RUN_ID"),
+    "runtime_id": runtime_id,
+    "session_id": config.get("session_id", "session-exact"),
+    "leaf_id": config.get("leaf_id", "leaf-exact"),
+    "session_file": config["session_file"],
+    "cwd": config["cwd"],
+    "version": version,
+    "idle": not (spawn == 0 and config.get("busy", False)),
+    "pending": spawn == 0 and config.get("pending", False),
+    "busy": spawn == 0 and config.get("busy", False),
+    "provider": "test-provider",
+    "model": "test-model",
+    "thinking": "high",
+}
+snapshot_override_path = config.get("snapshot_override_file")
+
+def current_snapshot():
+    current = dict(snapshot)
+    if snapshot_override_path:
+        try:
+            override = json.loads(Path(snapshot_override_path).read_text())
+        except FileNotFoundError:
+            pass
+        else:
+            current.update(override)
+    return current
+
+with Path(os.environ["FAKE_PI_LOG"]).open("a") as stream:
+    stream.write(json.dumps({
+        "spawn": spawn,
+        "argv": sys.argv[1:],
+        "token": token,
+        "runtime_id": runtime_id,
+        "version": version,
+        "models": models,
+    }) + "\n")
+
+if config.get("normal_exit"):
+    raise SystemExit(config.get("normal_exit_code", 23))
+
+stopping = False
+def handle_term(_signum, _frame):
+    global stopping
+    with Path(os.environ["FAKE_PI_SIGNAL_LOG"]).open("a") as stream:
+        stream.write(f"{spawn}:TERM\n")
+    if not (spawn == 0 and config.get("ignore_first_term", False)):
+        stopping = True
+
+def handle_int(_signum, _frame):
+    with Path(os.environ["FAKE_PI_SIGNAL_LOG"]).open("a") as stream:
+        stream.write(f"{spawn}:INT\n")
+
+signal.signal(signal.SIGTERM, handle_term)
+signal.signal(signal.SIGINT, handle_int)
+socket_path = Path(os.environ["PI_RUNTIME_EXTENSION_SOCKET"])
+socket_path.unlink(missing_ok=True)
+with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
+    server.bind(str(socket_path))
+    os.chmod(socket_path, 0o600)
+    server.listen(4)
+    server.settimeout(0.05)
+    while not stopping:
+        try:
+            connection, _ = server.accept()
+        except socket.timeout:
+            continue
+        with connection:
+            data = bytearray()
+            while b"\n" not in data and len(data) <= 16384:
+                chunk = connection.recv(4096)
+                if not chunk:
+                    break
+                data.extend(chunk)
+            try:
+                request = json.loads(bytes(data).split(b"\n", 1)[0])
+                if request.get("token") != token:
+                    raise ValueError("bad token")
+                if request.get("action") not in {"snapshot", "prepare", "cancel"}:
+                    raise ValueError("bad action")
+                reply_snapshot = current_snapshot()
+                if request.get("action") == "prepare":
+                    expected = request.get("expected")
+                    actual = {key: reply_snapshot[key] for key in ("runtime_id", "session_id", "leaf_id")}
+                    if expected != actual:
+                        raise ValueError("stale")
+                reply = {"ok": True, "result": reply_snapshot}
+            except Exception:
+                reply = {"ok": False, "error": "request rejected"}
+            connection.sendall(json.dumps(reply).encode() + b"\n")
+socket_path.unlink(missing_ok=True)
+'''
+
+
+class SupervisorHarness:
+    def __init__(self, case, **changes):
+        self.case = case
+        self.temporary = tempfile.TemporaryDirectory(prefix="pi-supervisor-test-")
+        case.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.runtime_dir = self.root / "runtime"
+        self.cwd = self.root / "project with spaces"
+        self.cwd.mkdir()
+        self.session_file = self.cwd / "session exact.jsonl"
+        self.session_file.write_text('{"type":"session"}\n')
+        self.fake_pi = self.root / "fake pi"
+        self.fake_pi.write_text(FAKE_PI)
+        self.fake_pi.chmod(0o755)
+        self.log = self.root / "spawns.jsonl"
+        self.signal_log = self.root / "signals.log"
+        self.state = self.root / "state"
+        self.snapshot_override = self.root / "snapshot-override.json"
+        self.config = {
+            "installed_version": "2.0.0",
+            "versions": ["1.0.0", "2.0.0"],
+            "runtime_ids": ["runtime-old", "runtime-new"],
+            "session_id": "session-exact",
+            "leaf_id": "leaf-exact",
+            "session_file": str(self.session_file),
+            "cwd": str(self.cwd),
+            "snapshot_override_file": str(self.snapshot_override),
+        }
+        self.config.update(changes)
+        self.config_path = self.root / "config.json"
+        self.config_path.write_text(json.dumps(self.config))
+        self.env = os.environ.copy()
+        self.env.update(
+            PI_RUNTIME_RUN_ID=RUN_ID,
+            PI_RUNTIME_DIR=str(self.runtime_dir),
+            FAKE_PI_CONFIG=str(self.config_path),
+            FAKE_PI_LOG=str(self.log),
+            FAKE_PI_SIGNAL_LOG=str(self.signal_log),
+            FAKE_PI_STATE=str(self.state),
+        )
+        self.process = None
+
+    def start(self, *pi_args, stop_timeout="0.25", start_timeout="2"):
+        command = [
+            sys.executable,
+            str(SUPERVISOR),
+            "--stop-timeout", stop_timeout,
+            "--start-timeout", start_timeout,
+            "--",
+            str(self.fake_pi),
+            *pi_args,
+        ]
+        self.process = subprocess.Popen(
+            command,
+            cwd=self.cwd,
+            env=self.env,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+        )
+        self.case.addCleanup(self.stop)
+        self.wait_for(lambda: (self.runtime_dir / "control.sock").exists())
+        self.wait_for(lambda: (self.runtime_dir / "extension.sock").exists())
+        return self
+
+    def stop(self):
+        if self.process is None or self.process.poll() is not None:
+            return
+        try:
+            os.killpg(self.process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            return
+        self.process.communicate(timeout=5)
+
+    def wait_for(self, predicate, timeout=5):
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            if predicate():
+                return
+            if self.process is not None and self.process.poll() is not None:
+                output, error = self.process.communicate()
+                self.case.fail(
+                    f"supervisor exited {self.process.returncode}: "
+                    f"stdout={output!r} stderr={error!r}"
+                )
+            time.sleep(0.02)
+        self.case.fail("timed out waiting for supervisor state")
+
+    def request(self, value, check=True):
+        completed = subprocess.run(
+            [sys.executable, str(CONTROL), "--request", json.dumps(value)],
+            env=self.env,
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        if check and completed.returncode != 0:
+            self.case.fail(f"control failed: {completed.stdout!r} {completed.stderr!r}")
+        return completed, json.loads(completed.stdout)
+
+    def status(self):
+        _, reply = self.request({"action": "status"})
+        self.case.assertTrue(reply["ok"], reply)
+        return reply["result"]
+
+    def wait_operation(self, expected_status, timeout=5):
+        result = None
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            result = self.status()
+            operation = result.get("operation")
+            if operation and operation["status"] == expected_status:
+                return result
+            time.sleep(0.03)
+        self.case.fail(f"operation did not reach {expected_status}: {result}")
+
+    def restart_request(self, **changes):
+        request = {
+            "action": "restart",
+            "run_id": RUN_ID,
+            "runtime_id": "runtime-old",
+            "session_id": "session-exact",
+            "leaf_id": "leaf-exact",
+            "operation_id": OPERATION_ID,
+        }
+        request.update(changes)
+        return self.request(request, check=False)
+
+    def spawns(self):
+        if not self.log.exists():
+            return []
+        return [json.loads(line) for line in self.log.read_text().splitlines()]
+
+    def override_snapshot(self, **changes):
+        self.snapshot_override.write_text(json.dumps(changes))
+
