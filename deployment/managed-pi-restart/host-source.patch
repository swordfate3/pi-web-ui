+data=json.load(sys.stdin)
+base=pathlib.Path('/home/node/.pi/agent/deploy-gate')
+base.mkdir(mode=0o700,exist_ok=True)
+if base.resolve()!=base: raise ValueError('symlinked client directory refused')
+for name,text in [('client.json',json.dumps(data['credential'])+'\n'),('pi-gate.py',data['script'])]:
+ fd,tmp=tempfile.mkstemp(prefix='.install-',dir=base)
+ with os.fdopen(fd,'w') as stream: stream.write(text)
+ os.chmod(tmp,0o700 if name=='pi-gate.py' else 0o600)
+ os.replace(tmp,base/name)
