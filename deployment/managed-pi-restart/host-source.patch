+def docker(*args, data=None, timeout=30):
+    result = subprocess.run(['docker', *args], input=data, stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, timeout=timeout)
+    if result.returncode:
+        raise RuntimeError('Docker/admin operation failed; use gatectl status and container health for diagnosis')
+    return result.stdout
+
+
+def admin(command, identifier=None, commit=None, plan=None, payload=None):
+    args = ['exec', GATE, '/usr/bin/python3', '-m', 'gate.admin', command]
+    if payload is not None:
+        args.insert(1, '-i')
+        args.append('--json-stdin')
+    if identifier:
+        args.append(identifier)
+    if commit:
+        args.extend(('--commit', commit))
+    if plan:
+        args.extend(('--plan', plan))
+    return json.loads(docker(*args, data=json.dumps(payload).encode() if payload is not None else None))
+
+
+def read_definition(path):
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(descriptor, 'rb') as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            raise ValueError('definition must be a regular file')
+        raw = stream.read(65537)
+    if len(raw) > 65536:
+        raise ValueError('definition exceeds limit')
+    return json.loads(raw)
+
+
+def check_upgrade_ready():
+    # An inaccessible daemon is not the same as an absent gate.
+    existing = docker('ps', '-a', '--filter', 'name=^/' + GATE + '$', '--format', '{{.ID}}').split()
+    if not existing:
+        return
+    if len(existing) != 1:
+        raise RuntimeError('ambiguous gate identity')
+    info = json.loads(docker('inspect', GATE))
+    if not info[0]['State']['Running']:
+        raise RuntimeError('existing gate is stopped; restore the reviewed gate and inspect state before upgrade')
+    status = admin('status')
+    jobs = status.get('active', status['requests'])
+    if status.get('lifecycle_active') or any(job['status'] in ('deploying', 'recovering', 'recovery_required') for job in jobs):
+        raise RuntimeError('deployment or recovery active; do not replace gate')
+    return True
+
+
+def finish_upgrade(identifier):
+    status = admin('upgrade-status')
+    reservation = status.get('reservation')
+    if not reservation or reservation['id'] != identifier:
+        raise RuntimeError('upgrade reservation changed')
+    info = json.loads(docker('inspect', GATE))
+    if (len(info) != 1 or info[0]['State']['Running'] is not True or
+            info[0]['Image'] != reservation['image']):
+        raise RuntimeError('replacement image is not the reserved image')
+    return admin('upgrade-finish', payload={'id': identifier})
+
