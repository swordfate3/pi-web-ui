+if bindir.resolve()!=bindir: raise ValueError('symlinked executable directory refused')
+link=bindir/'pi-gate'
+if link.exists() and not link.is_symlink(): raise ValueError('existing pi-gate executable refused')
+temporary=bindir/('.pi-gate-'+os.urandom(8).hex())
+temporary.symlink_to(base/'pi-gate.py')
+os.replace(temporary,link)
+print('Request-only client installed; no administrator credential was copied.')
+'''
+    docker('exec', '-i', '--user', '1000:1000', container, '/usr/bin/python3', '-c', installer,
+           data=json.dumps(payload).encode())
+    print('Pi 申请客户端已安装到共享 pi-home；已有及新 Pi 均可使用，无需重启。')
