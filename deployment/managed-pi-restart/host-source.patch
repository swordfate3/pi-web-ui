+    def test_terminal_failure_refreshes_busy_state_and_retains_operation(self):
+        harness = SupervisorHarness(self, busy=True).start()
+        harness.wait_for(lambda: harness.status()["busy"] is True)
+        completed, accepted = harness.restart_request()
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertTrue(accepted["ok"], accepted)
+        terminal = harness.wait_operation("failed")["operation"]
+
+        harness.override_snapshot(idle=True, pending=False, busy=False)
+        refreshed = harness.status()
+
+        self.assertTrue(refreshed["idle"])
+        self.assertFalse(refreshed["busy"])
+        self.assertEqual(refreshed["operation"], terminal)
+
+    def test_terminal_success_refreshes_session_leaf_and_retains_operation(self):
+        harness = SupervisorHarness(self).start()
+        harness.wait_for(lambda: harness.status()["runtime_id"] == "runtime-old")
+        completed, accepted = harness.restart_request()
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertTrue(accepted["ok"], accepted)
+        terminal = harness.wait_operation("succeeded")["operation"]
+
+        harness.override_snapshot(session_id="session-later", leaf_id="leaf-later")
+        refreshed = harness.status()
+
+        self.assertEqual(refreshed["session_id"], "session-later")
+        self.assertEqual(refreshed["leaf_id"], "leaf-later")
+        self.assertEqual(refreshed["operation"], terminal)
