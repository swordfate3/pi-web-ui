+def export_lifecycle(destination):
+    """Create once under a non-symlinked private host directory; never echo token."""
+    path = Path(destination)
+    if not path.is_absolute() or '..' in path.parts or path.name in ('', '.', '..'):
+        raise ValueError('absolute new credential path required')
+    directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for part in path.parts[1:-1]:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
+            os.close(directory)
+            directory = child
+        info = os.fstat(directory)
+        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
+            raise ValueError('credential directory must be owned and not writable by others')
+        descriptor = os.open(path.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                             0o600, dir_fd=directory)
+        with os.fdopen(descriptor, 'w') as stream:
+            value = admin('lifecycle-export', payload={})
+            if (not isinstance(value, dict) or set(value) != {'token'} or
+                    not isinstance(value['token'], str) or not re.fullmatch('[0-9a-f]{64}', value['token'])):
+                raise ValueError('invalid lifecycle credential')
+            os.fchmod(stream.fileno(), 0o600)
+            json.dump(value, stream)
+            stream.write('\n')
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+    print('生命周期凭据已写入指定的0600文件；不会显示凭据，不会启用策略。')
+
