+    def test_slow_version_check_is_async_and_status_remains_responsive(self):
+        harness = SupervisorHarness(self, version_delay=3.5).start()
+        harness.wait_for(lambda: harness.status()["runtime_id"] == "runtime-old")
+
+        started = time.monotonic()
+        completed, accepted = harness.restart_request()
+        submit_elapsed = time.monotonic() - started
+
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertTrue(accepted["ok"], accepted)
+        self.assertEqual(accepted["result"], {
+            "operation_id": OPERATION_ID,
+            "status": "running",
+            "stage": "checking",
+        })
+        self.assertLess(submit_elapsed, 1.0)
+        status_started = time.monotonic()
+        status = harness.status()
+        self.assertLess(time.monotonic() - status_started, 1.0)
+        self.assertEqual(status["operation"]["status"], "running")
+        self.assertEqual(status["operation"]["stage"], "checking")
+        result = harness.wait_operation("succeeded", timeout=8)
+        self.assertEqual(result["operation"]["stage"], "complete")
+        self.assertEqual(len(harness.spawns()), 2)
