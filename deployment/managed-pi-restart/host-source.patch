+        session = directory / "saved.jsonl"
+        session.write_text("saved\n")
+        snapshot = dict(run_id="1" * 32, runtime_id="old", session_id="saved", leaf_id="leaf",
+                        session_file=str(session), cwd=str(directory), version="1.1.0", idle=True,
+                        pending=False, busy=False, provider="faux", model="faux", thinking="off")
+        request = dict(action="restart", run_id="1" * 32, operation_id="2" * 32,
