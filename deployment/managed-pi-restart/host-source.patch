+class FakeClock:
+    def __init__(self):
+        self.wall, self.mono = 1800000000.0, 1000.0
+
+    def time(self):
+        return self.wall
+
+    def monotonic(self):
+        return self.mono
+
+    def sleep(self, seconds):
+        self.advance(seconds)
+
+    def advance(self, seconds):
+        self.wall += seconds
+        self.mono += seconds
