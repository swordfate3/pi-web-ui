+"""Real provider and Engine against a controlled Unix Docker HTTP boundary."""
+import copy
+import http.server
+import importlib.util
+import json
+from pathlib import Path
+import socket
+import socketserver
+import struct
+import tempfile
+import threading
+import time
+import unittest
+
+from gate.engine import Engine
+from gate.service import Gate
+from test_lifecycle import FakeEngine, RUN, CID, IMAGE
+from test_terminal_admission import terminal
+
+TARGET = dict(v=1, runId=RUN, runtimeId='runtime', sessionId='session', terminalEpoch='e' * 32,
+              profile='web-terminal-v1', inputState='none', managedRestartEligible=False)
+TOKEN = '7' * 64
+
+
+def line(value):
+    return json.dumps(value, separators=(',', ':')).encode() + b'\n'
+
+
+class DockerServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
+    daemon_threads = True
+
+
+class DockerHandler(http.server.BaseHTTPRequestHandler):
+    protocol_version = 'HTTP/1.1'
+    rbufsize = 0
+
+    def log_message(self, *_):
+        pass
+
+    def do_GET(self):
+        state = self.server.state
+        state['calls'].append(self.path)
+        if self.path.startswith('/v1.45/containers/json?'):
+            value = [{'Id': key} for key in state['ids']]
+        elif self.path == '/v1.45/containers/' + CID + '/json':
+            value = state['item']
+        else:
+            self.send_error(404)
+            return
+        data = json.dumps(value).encode()
+        self.send_response(200)
+        self.send_header('Content-Length', str(len(data)))
+        self.end_headers()
+        self.wfile.write(data)
+
+    def do_POST(self):
+        state = self.server.state
+        value = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+        state['calls'].append(self.path)
+        if self.path == '/v1.45/containers/' + CID + '/exec':
+            state['execs'].append(value)
+            if state.get('after_create'):
+                state['after_create']()
+            data = line({'Id': 'f' * 64})
+            self.send_response(201)
+            self.send_header('Content-Length', str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+            return
+        if self.path != '/v1.45/exec/' + 'f' * 64 + '/start':
+            self.send_error(404)
+            return
+        self.send_response(101)
+        self.send_header('Connection', 'Upgrade')
+        self.send_header('Upgrade', 'tcp')
+        self.end_headers()
+        self.close_connection = True
+        self.connection.settimeout(3)
+        def send(data, kind=1):
+            self.connection.sendall(bytes([kind, 0, 0, 0]) + struct.pack('>I', len(data)) + data)
+        try:
+            first = json.loads(self.rfile.readline(65537))
+            state['frames'].append(first)
+            state['opened'].set()
+            if state.get('raw') is not None:
+                if state.get('fragment'):
+                    for byte in state['raw']:
+                        self.connection.sendall(bytes([byte]))
+                else:
+                    self.connection.sendall(state['raw'])
+                time.sleep(.2)
+                return
+            send(line({'type': 'ready', 'target': TARGET}))
+            if first['op'] == 'status':
+                return
+            if state.get('partial'):
+                send(b'{"type":')
+                time.sleep(2.5)
+                return
+            while True:
+                raw = self.rfile.readline(65537)
+                if not raw:
+                    return
+                frame = json.loads(raw)
+                state['frames'].append(frame)
+                send(line({'type': 'response', 'id': frame['id'], 'result': {'ok': True}}))
+        except (OSError, ValueError):
+            pass
+        finally:
+            state['closed'].set()
+
+
+class ProviderTests(unittest.TestCase):
