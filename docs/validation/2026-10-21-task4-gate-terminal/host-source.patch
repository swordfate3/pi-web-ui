+"""Terminal role must never acquire legacy child restart authority."""
+import copy
+import unittest
+
+import test_lifecycle as lifecycle_tests
+import test_runtime_updates as update_tests
+from test_lifecycle import BODY, RUN
+from test_runtime_updates import KEY
+
+
+def terminal(item):
+    item['HostConfig']['LogConfig'] = {'Type': 'none', 'Config': {}}
+    item['Config']['Labels']['cn.swordfate.pi.runtime-profile'] = 'web-terminal-v1'
+    item['Config']['Env'] = ['PI_RUNTIME_PROFILE=web-terminal-v1', 'PI_RUNTIME_RUN_ID=' + item['Config']['Labels']['cn.swordfate.pi.run-id']]
+    return item
+
+
+class TerminalAdmission(unittest.TestCase):
+    setUp = lifecycle_tests.LifecycleTest.setUp
+    lifecycle = lifecycle_tests.LifecycleTest.lifecycle
+    def test_terminal_cannot_restart_even_with_idle_lifecycle_claim(self):
+        life = self.lifecycle()
+        terminal(self.engine.item)
+        with self.assertRaisesRegex(RuntimeError, 'terminal_profile_unaudited'):
+            life.submit(BODY)
+        self.assertEqual(self.engine.calls, [])
+
+
+class TerminalInventory(unittest.TestCase):
+    setUp = update_tests.RuntimeUpdatesTest.setUp
+    manager = update_tests.RuntimeUpdatesTest.manager
+    pump = update_tests.RuntimeUpdatesTest.pump
+    def test_terminal_install_finishes_without_status_or_refresh_proof(self):
+        manager = self.manager()
+        self.docker.list_terminal = self.docker.list_lifecycle
+        terminal(self.docker.items['2' * 64])
+        # No legacy status socket exists on this consumer.
+        original = self.docker.lifecycle_control
+        def control(cid, request, timeout=None):
+            self.assertNotEqual(cid, '2' * 64, 'terminal must never use control.sock')
+            return original(cid, request, timeout)
+        self.docker.lifecycle_control = control
+        manager.submit({'version': '1.3.0', 'idempotency_key': KEY})
+        self.pump()
+        job = manager.get(KEY)
+        self.assertEqual(job['status'], 'manual_restart_required')
+        self.assertEqual(job['stage'], 'installed_manual_restart_required')
+        self.assertEqual(self.install.starts, 1)
+        self.assertEqual(self.docker.restarts, ['1' * 64])
+        target = next(t for t in job['targets'] if t['run_id'] == '2' * 32)
+        self.assertEqual(target, {'run_id': '2' * 32, 'status': 'manual_restart_required',
+                                 'profile': 'web-terminal-v1', 'wait_reason': 'terminal_profile_unaudited'})
+        self.assertEqual(manager.active(), [])
