+"""Explicit terminal mode must refuse before credentials/container launch."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import unittest
+from test_pirun_runtime import PirunRuntimeTests, ROOT
+
+
+class TerminalLauncherTests(unittest.TestCase):
+    setUp = PirunRuntimeTests.setUp
+    launch = PirunRuntimeTests.launch
+    capture_tty = PirunRuntimeTests.capture_tty
+    service = PirunRuntimeTests.service
+
+    def prepare(self, **changes):
+        self.env.update(PI_PIRUN_WEB_TERMINAL='on', PI_PIRUN_WEB_HUB='on',
+                        PI_PIRUN_IMAGE='sha256:' + 'a' * 64,
+                        PI_PIRUN_WEB_HUB_RUNS_DIR=str(self.root/'hub-runs'),
+                        PI_TEST_HUB_STATE=str(self.root/'fake-hub'),
+                        PI_PIRUN_DOCKER_BIN=str(self.root/'docker'))
+        transport = self.root/'docker'
+        transport.write_text('''#!/usr/bin/python3
+import json,os,subprocess,sys
+from pathlib import Path
+args=sys.argv[1:]
+if args[:2]==['image','inspect']:
+ print(json.dumps({} if os.environ.get('PI_TEST_IMAGE_MISSING') else {'cn.swordfate.pi.terminal-runtime':'web-terminal-v1'}));sys.exit(0)
+if args[:3]==['exec','-i','pi-deploy-gate']:
+ request=json.load(sys.stdin)
+ if os.environ.get('PI_TEST_PREFLIGHT_FAIL'):sys.exit(1)
+ print(json.dumps(dict(v=1,profile='web-terminal-v1',image=request['image'],instanceId='c'*32,ready=True)));sys.exit(0)
+if args[:6]==['exec','--user','1000:1000','pi-web-hub','node','-e'] and 'terminal' in args[6]:
+ print(json.dumps({'ready':not bool(os.environ.get('PI_TEST_TERMINAL_MISSING'))}));sys.exit(0)
+os.execv(''' + repr(str(ROOT/'tests/fixtures/hub-docker')) + ''', ['hub-docker',*args])
+''')
+        transport.chmod(0o700)
+        self.env.update(changes)
+
+    def tty_failure(self, *args):
+        master, slave = os.openpty()
+        try:
+            result = subprocess.run(['bash',str(ROOT/'scripts/pi-pirun'),*args], cwd=self.workspace,
+                                    env=self.env,stdin=slave,stdout=slave,stderr=subprocess.PIPE,timeout=8)
+            self.assertNotEqual(result.returncode,0)
+            grants=self.root/'fake-hub'
+            self.assertEqual(list(grants.glob('*.json')),[])
+            return result
+        finally:
+            os.close(master);os.close(slave)
+
+    def test_terminal_without_tty_refuses_before_any_grant(self):
+        self.prepare()
+        result=self.launch(check=False)
+        self.assertNotEqual(result.returncode,0)
+        self.assertEqual(list((self.root/'fake-hub').glob('*.json')),[])
+
+    def test_terminal_maintenance_rpc_and_extension_bypass_refuse(self):
+        self.prepare()
+        for args in [('update','pi'),('--mode','rpc'),('--print','hello'),('--no-extensions',),('--no-session',)]:
+            with self.subTest(args=args): self.tty_failure(*args)
+
+    def test_invalid_owner_and_mode_refuse(self):
+        self.prepare(PI_PIRUN_WEB_TERMINAL_CONTROL='automatic')
+        self.tty_failure()
+        self.env.update(PI_PIRUN_WEB_TERMINAL='auto',PI_PIRUN_WEB_TERMINAL_CONTROL='local')
+        self.tty_failure()
+
+    def test_missing_prerequisites_refuse_before_grant(self):
+        self.prepare()
+        for key,value in [('PI_PIRUN_WEB_HUB','off'),('PI_TEST_PREFLIGHT_FAIL','1'),
+                          ('PI_TEST_TERMINAL_MISSING','1'),('PI_TEST_IMAGE_MISSING','1'),('PI_PIRUN_IMAGE','pi-sandbox')]:
+            with self.subTest(key=key):
+                previous=self.env.get(key)
+                self.env[key]=value
+                self.tty_failure()
+                if previous is None:self.env.pop(key)
+                else:self.env[key]=previous
+
+    def test_explicit_terminal_compose_logging_profile_and_default_local_owner(self):
+        self.prepare()
+        captured=self.capture_tty()
+        service=self.service(captured)
+        args=captured['args']
+        self.assertEqual(service['logging']['driver'],'none')
+        self.assertIn(str(ROOT/'compose.terminal.yaml'),args)
+        self.assertIn('PI_RUNTIME_PROFILE=web-terminal-v1',args)
+        self.assertIn('PI_PIRUN_WEB_TERMINAL_CONTROL=local',args)
+        self.assertIn('PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',args)
+        self.assertIn('cn.swordfate.pi.runtime-profile=web-terminal-v1',args)
+        self.assertNotIn('provider.sock',json.dumps(captured))
+        self.assertNotIn('pi-terminal-credentials',json.dumps(captured))
+        self.assertIn('cn.swordfate.pi.lifecycle=1',args)
+        self.assertEqual(args[-1],'pi')
+
+    def test_remote_is_initially_unowned_not_automatic_browser_control(self):
+        self.prepare(PI_PIRUN_WEB_TERMINAL_CONTROL='remote')
+        captured=self.capture_tty()
+        self.assertIn('PI_PIRUN_WEB_TERMINAL_CONTROL=remote',captured['args'])
+
+    def test_source_entrypoint_terminal_never_falls_back_to_pi_on_non_tty(self):
+        self.prepare()
+        result=subprocess.run(['bash',str(ROOT/'pi-entrypoint'),'--version'],env=dict(self.env,
+                              PI_RUNTIME_PROFILE='web-terminal-v1'),capture_output=True,timeout=3)
+        self.assertNotEqual(result.returncode,0)
+        self.assertNotIn(b'command not found',result.stderr)
+
+    def test_terminal_version_source_is_shared_pi_not_image_frozen_copy(self):
+        entry=(ROOT/'pi-entrypoint').read_text()
+        image=(ROOT/'Dockerfile.terminal').read_text()
+        self.assertIn('/usr/local/bin/node /home/node/.local/lib/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js',entry)
+        self.assertNotIn('/opt/pi-terminal-agent',entry+image)
+        self.assertIn('ln -s /home/node/.local/lib/node_modules/@earendil-works/pi-coding-agent',image)
+
+    def test_terminal_dispatch_preserves_ssh_and_models_preparation(self):
+        entry=(ROOT/'pi-entrypoint').read_text()
+        dispatch=entry.index('exec /usr/bin/python3 -I /usr/local/lib/pi-runtime/terminal/supervisor.py')
+        self.assertLess(entry.index('cp -r /run/host-ssh/.'),dispatch)
+        self.assertLess(entry.index('/usr/bin/python3 "$model_sync_helper"'),dispatch)
+
+
+if __name__=='__main__':unittest.main()
