@@ -0,0 +1,142 @@
+"""Host-only preflight: frozen live policy, no target exec, bounded host client."""
+import http.client
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import threading
+import time
+from types import SimpleNamespace
+import unittest
+
+from gate.service import Gate, start_servers
+from gate.terminal_provider import TerminalProvider
+
+ROOT = Path(__file__).resolve().parents[1]
+IMAGE = 'sha256:' + 'a' * 64
+
+
+class PreflightTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='pi-task6-admin-')
+        self.addCleanup(self.tmp.cleanup)
+        self.gate = Gate(Path(self.tmp.name))
+        self.http, self.admin = start_servers(self.gate, 0)
+        self.provider = TerminalProvider(self.gate, {'enabled': True, 'images': [IMAGE]}, 'f' * 64)
+        self.gate.terminal_server = SimpleNamespace(
+            provider=self.provider, thread=threading.current_thread(), server=self.admin)
+        def cleanup():
+            self.gate.terminal_server = None
+            self.provider.close()
+            for server in (self.http, self.admin):
+                server.shutdown()
+                server.server_close()
+            self.gate.close()
+        self.addCleanup(cleanup)
+
+    def request(self, body, public=False, token=None):
+        connection = http.client.HTTPConnection(
+            *self.http.server_address, timeout=3) if public else http.client.HTTPConnection('localhost', timeout=3)
+        if not public:
+            connection.sock = socket.socket(socket.AF_UNIX)
+            connection.sock.settimeout(3)
+            connection.sock.connect(str(self.gate.directory / 'admin.sock'))
+        connection.request('POST', '/admin/terminal-preflight', body,
+                           {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (token or self.gate.token)})
+        response = connection.getresponse()
+        result = response.status, json.loads(response.read())
+        connection.close()
+        return result
+
+    def test_exact_success_uses_live_frozen_policy_without_engine(self):
+        # Any Engine access is a bug: this operation is not target admission.
+        class ForbiddenEngine:
+            def __getattr__(self, name):
+                raise AssertionError('preflight accessed Engine: ' + name)
+        self.gate.lifecycle.engine = ForbiddenEngine()
+        code, value = self.request(json.dumps({'image': IMAGE}))
+        self.assertEqual(code, 200)
+        self.assertEqual(value, dict(v=1, profile='web-terminal-v1', image=IMAGE,
+                                    instanceId=self.gate.instance_id, ready=True))
+        self.assertRegex(value['instanceId'], r'^[0-9a-f]{32}$')
+        self.assertEqual(self.request(json.dumps({'image': 'sha256:' + 'b' * 64}))[0], 400)
+
+    def test_closed_schema_and_body_bounds(self):
+        for body in ('{}', '[]', '{"image":"tag"}', json.dumps({'image': IMAGE, 'runId': 'a' * 32}),
+                     '{"image":"tag","image":"' + IMAGE + '"}', ' ' * 4096 + '{}'):
+            with self.subTest(body=body[:100]):
+                self.assertEqual(self.request(body)[0], 400)
+
+    def test_missing_disabled_closed_and_closing_are_unavailable(self):
+        listener = self.gate.terminal_server
+        self.gate.terminal_server = None
+        self.assertEqual(self.request(json.dumps({'image': IMAGE}))[0], 400)
+        self.gate.terminal_server = listener
+        self.provider.policy['enabled'] = False
+        self.assertEqual(self.request(json.dumps({'image': IMAGE}))[0], 400)
+        self.provider.policy['enabled'] = True
+        self.provider.closed = True
+        self.assertEqual(self.request(json.dumps({'image': IMAGE}))[0], 400)
+        self.provider.closed = False
+        self.gate.closing = True
+        self.assertEqual(self.request(json.dumps({'image': IMAGE}))[0], 400)
+
+    def test_tcp_tokens_cannot_reach_admin_preflight(self):
+        for token in (self.gate.token, self.gate.lifecycle_token, self.provider.token):
+            self.assertNotEqual(self.request(json.dumps({'image': IMAGE}), public=True, token=token)[0], 200)
+
+    def test_actual_admin_module_roundtrip(self):
+        result = subprocess.run(['/usr/bin/python3', '-m', 'gate.admin', '--state', self.tmp.name,
+                                 'terminal-preflight', '--json-stdin'], cwd=ROOT,
+                                input=json.dumps({'image': IMAGE}).encode(), capture_output=True, timeout=3)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)['instanceId'], self.gate.instance_id)
+        self.assertLessEqual(len(result.stdout), 4096)
+
+
+class HostPreflightClientTest(unittest.TestCase):
+    def run_host(self, source, image=IMAGE):
+        with tempfile.TemporaryDirectory(prefix='pi-task6-client-') as directory:
+            executable = Path(directory) / 'docker'
+            executable.write_text('#!/usr/bin/python3\n' + source)
+            executable.chmod(0o700)
+            started = time.monotonic()
+            result = subprocess.run(['/usr/bin/python3', str(ROOT / 'gatectl'),
+                                     'terminal-preflight', '--image', image],
+                                    env=dict(os.environ, PATH=directory + ':' + os.environ.get('PATH', '')),
+                                    capture_output=True, timeout=4)
+            return result, time.monotonic() - started
+
+    def test_fixed_host_transport_and_exact_success(self):
+        body = dict(v=1, profile='web-terminal-v1', image=IMAGE, instanceId='c' * 32, ready=True)
+        result, _ = self.run_host('import sys,json\n'
+            'assert sys.argv[1:] == ["exec","-i","pi-deploy-gate","/usr/bin/python3","-m","gate.admin","terminal-preflight","--json-stdin"]\n'
+            'assert json.load(sys.stdin) == {"image": "' + IMAGE + '"}\n'
+            'print(' + repr(json.dumps(body)) + ')\n')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout), body)
+
+    def test_unsupported_malformed_and_oversized_fail_closed(self):
+        for source in ('raise SystemExit(2)\n', 'print("{}")\n', 'print("x"*5000)\n',
+                       'print(\'{' + '"ready":true,"ready":true}\')\n'):
+            with self.subTest(source=source):
+                result, _ = self.run_host(source)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(result.stdout, b'')
+
+    def test_absolute_budget_does_not_reset_on_slow_bytes(self):
+        result, elapsed = self.run_host('import os,time\nfor _ in range(24):\n os.write(1,b" ")\n time.sleep(.15)\n')
+        self.assertNotEqual(result.returncode, 0)
+        self.assertLess(elapsed, 2.7)
+        self.assertEqual(result.stdout, b'')
+
+    def test_invalid_image_rejected_before_docker(self):
+        result, _ = self.run_host('raise AssertionError("must not invoke Docker")\n', 'pi-sandbox')
+        self.assertEqual(result.returncode, 2)
+        self.assertNotIn(b'AssertionError', result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
