+#!/usr/bin/python3
+"""Host-only opt-in checks. Never issue a run or grant target execution."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+import subprocess
+import sys
+
+CONFIG_DIR = Path(__file__).resolve().parents[1]
+
+
+def check(workspace, image):
+    # Reuse the ordinary helper's workspace/transport checks without changing its
+    # CLI or credential lifecycle. This source is not installed into Pi images.
+    hub = runpy.run_path(str(Path(__file__).with_name('pi-web-hub-session')))
+    hub['check_workspace'](workspace)
+    if not re.fullmatch('sha256:[0-9a-f]{64}', image):
+        raise ValueError('immutable terminal image required')
+    labels = json.loads(hub['docker']('image', 'inspect', '--format', '{{json .Config.Labels}}', image))
+    if not isinstance(labels, dict) or labels.get('cn.swordfate.pi.terminal-runtime') != 'web-terminal-v1':
+        raise ValueError('image lacks installed terminal runtime')
+    # One outer absolute timeout includes host gatectl startup and fixed exec.
+    result = subprocess.run(['/usr/bin/python3', str(CONFIG_DIR.parent / 'pi-deploy-gate/gatectl'),
+                             'terminal-preflight', '--image', image],
+                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=2, check=True)
+    reply = json.loads(result.stdout)
+    if (len(result.stdout) > 4096 or not isinstance(reply, dict) or
+            set(reply) != {'v', 'profile', 'image', 'instanceId', 'ready'} or
+            type(reply['v']) is not int or reply['v'] != 1 or reply['profile'] != 'web-terminal-v1' or
+            reply['image'] != image or reply['ready'] is not True or
+            not isinstance(reply['instanceId'], str) or not re.fullmatch('[0-9a-f]{32}', reply['instanceId'])):
+        raise ValueError('invalid preflight reply')
+    state = json.loads(hub['docker']('inspect', '--format', '{{json .State}}',
+                                   os.environ.get('PI_PIRUN_WEB_HUB_CONTAINER', 'pi-web-hub')))
+    if not state.get('Running') or state.get('Health', {}).get('Status') != 'healthy':
+        raise ValueError('Hub unavailable')
+    ready = json.loads(hub['hub_node']('-e',
+        'const c=JSON.parse(require("fs").readFileSync("/hub/private/config.json","utf8"));'
+        'const t=c.terminal; console.log(JSON.stringify({ready:!!(t&&t.port&&t.provider&&'
+        't.provider.socketPath&&t.provider.credentialFile)}));'))
+    if ready != {'ready': True}:
+        raise ValueError('Hub terminal listener/provider not configured')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--workspace', required=True)
+    parser.add_argument('--image', required=True)
+    args = parser.parse_args()
+    try:
+        check(args.workspace, args.image)
+    except Exception:
+        print('Terminal prerequisites unavailable; ordinary chat is read-only from startup in this mode.', file=sys.stderr)
+        sys.exit(1)
