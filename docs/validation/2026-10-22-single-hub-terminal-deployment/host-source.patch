@@ -0,0 +1,29 @@
+"""Run real Compose rendering; no daemon or production state required."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@unittest.skipUnless(shutil.which('docker'), 'Docker Compose CLI unavailable')
+class TerminalComposeContract(unittest.TestCase):
+    def test_rendered_provider_mounts_are_readonly_and_nocopy(self):
+        env = {k:v for k,v in os.environ.items() if not k.startswith('COMPOSE_')}
+        env.update(COMPOSE_DISABLE_ENV_FILE='1', PI_HUB_IMAGE='sha256:'+'a'*64)
+        result = subprocess.run(['docker', 'compose', '--env-file','/dev/null',
+            '-f',str(ROOT/'compose.hub.yaml'),'-f',str(ROOT/'compose.hub-terminal.yaml'),
+            'config','--format','json'],env=env,capture_output=True,text=True,timeout=15)
+        self.assertEqual(result.returncode,0,result.stderr)
+        config = json.loads(result.stdout)
+        mounts = config['services']['hub']['volumes']
+        self.assertEqual(len(mounts),4)
+        for source,target in (('terminal-ipc','/run/pi-terminal-provider'),
+                              ('terminal-credentials','/run/pi-terminal-credentials')):
+            selected = [m for m in mounts if m['target']==target]
+            self.assertEqual(len(selected),1)
+            self.assertEqual(selected[0],dict(type='volume',source=source,target=target,
+                read_only=True,volume={'nocopy':True}))
