+"""Real daemon migration/rollback; namespace provider volumes in a test adapter.
+
+No production volume, credential, terminal target or service is mounted/changed.
+The adapter translates only the two closed source-volume names at Docker's edge;
+all policy/deployer/artifact/state logic is production code.
+"""
+import copy
+import json
+from pathlib import Path
+import secrets
+import socket
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from gate.deploy import Deployer
+from gate.engine import Engine
+from gate.store import Store
+
+REPO = Path('/home/fate/gitproject/codex_project_v2/pi-web-ui')
+
+
+class IsolatedEngine(Engine):
+    def __init__(self, mapping):
+        super().__init__()
+        self.mapping = mapping
+
+    def create(self, name, body):
+        value = copy.deepcopy(body)
+        value['HostConfig']['Binds'] = [self.mapping.get(b.split(':')[0], b.split(':')[0]) + ':' + b.split(':', 1)[1]
+                                       for b in value['HostConfig'].get('Binds', [])]
+        return super().create(name, value)
+
+    def inspect(self, key, timeout=None):
+        value = super().inspect(key, timeout)
+        if value:
+            inverse = {v: k for k, v in self.mapping.items()}
+            for mount in value.get('Mounts', []):
+                if mount.get('Name') in inverse: mount['Name'] = inverse[mount['Name']]
+            host = value['HostConfig']
+            host['Binds'] = [inverse.get(b.split(':')[0], b.split(':')[0]) + ':' + b.split(':', 1)[1]
+                             for b in host.get('Binds') or []]
+        return value
+
+
+def main():
+    raw = Engine()
+    prefix = 'pi-terminal-migration-it-' + secrets.token_hex(5)
+    mapping = {'pi-terminal-provider-ipc': prefix + '-ipc',
