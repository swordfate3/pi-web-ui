+"""Closed terminal release assets and fixed readonly Hub provider migration."""
+import copy
+import hashlib
+import io
+import tarfile
+import tempfile
+import unittest
+from pathlib import Path
+
+from gate.artifacts import bundle_from_archive, build_context
+from gate.registry import validate_service
+from gate.store import Store
+import test_deploy
+
+
+ASSETS = {'index.html': b'<html>terminal</html>', 'app.js': b'console.log(2)', 'app.css': b'body{}'}
+PROVIDER = [
+    {'Type': 'volume', 'Name': 'pi-terminal-provider-ipc', 'Destination': '/run/pi-terminal-provider', 'RW': False},
+    {'Type': 'volume', 'Name': 'pi-terminal-provider-credentials', 'Destination': '/run/pi-terminal-credentials', 'RW': False},
+]
+
+
+def release(assets=ASSETS, extras=()):
+    entries = [('dist/hub/pi-web-hub.mjs', b'console.log(1)', tarfile.REGTYPE),
+               ('LICENSE', b'MIT', tarfile.REGTYPE)]
+    entries += [('dist/terminal/' + name, data, tarfile.REGTYPE) for name, data in assets.items()]
+    return test_deploy.archive(entries + list(extras))
+
+
+class TerminalReleaseTests(unittest.TestCase):
+    def test_complete_inventory_enters_fixed_context_without_arbitrary_files(self):
+        bundle, license, assets = bundle_from_archive(release(extras=[('dist/terminal/evil.sh', b'evil', tarfile.REGTYPE)]), test_deploy.SHA)
+        self.assertEqual(assets, ASSETS)
+        data = build_context(bundle, license, 'sha256:' + 'a' * 64, test_deploy.SHA, terminal=assets)
+        with tarfile.open(fileobj=io.BytesIO(data)) as archive:
+            self.assertEqual(sorted(archive.getnames()), ['Dockerfile', 'LICENSE', 'pi-web-hub.mjs',
+                'terminal/app.css', 'terminal/app.js', 'terminal/index.html'])
+            self.assertEqual(archive.extractfile('terminal/app.js').read(), b'console.log(2)')
+            self.assertIn(b'COPY terminal/ /opt/pi-web-ui/dist/terminal/', archive.extractfile('Dockerfile').read())
+
+    def test_partial_duplicate_linked_empty_and_oversized_assets_fail_closed(self):
+        cases = [release({'index.html': b'page'}),
+                 release(extras=[('dist/terminal/app.js', b'duplicate', tarfile.REGTYPE)]),
+                 release(extras=[('dist/terminal/app.js', b'', tarfile.SYMTYPE)]),
+                 release(dict(ASSETS, **{'app.css': b''})),
+                 release(dict(ASSETS, **{'app.js': b'x' * (2 * 1024 * 1024 + 1)}))]
+        for data in cases:
+            with self.subTest(size=len(data)), self.assertRaises(ValueError):
+                bundle_from_archive(data, test_deploy.SHA)
+
+    def test_context_rejects_untrusted_asset_names(self):
+        for assets in ({'../evil': b'evil'}, dict(ASSETS, **{'extra': b'evil'})):
+            with self.assertRaises(ValueError):
+                build_context(b'hub', b'MIT', 'sha256:' + 'a' * 64, test_deploy.SHA, terminal=assets)
+
+
+class TerminalMountTests(test_deploy.DeploymentTest):
+    def enabled(self, bad=False):
+        dep, store, engine, job = self.setup_gate(bad)
+        dep.policy['terminal_provider'] = True
+        dep.fetch = lambda _: (b'console.log(1)', b'MIT', ASSETS)
+        return dep, store, engine, job
+
+    def install_mounts(self, engine):
+        engine.items['old']['Mounts'] += copy.deepcopy(PROVIDER)
+        engine.items['old']['HostConfig']['Binds'] += [m['Name'] + ':' + m['Destination'] + ':ro' for m in PROVIDER]
+
+    def test_explicit_optin_migrates_only_exact_legacy_template(self):
+        dep, store, engine, job = self.enabled()
+        dep.run(job)
+        self.assertEqual(store.get(job['id'])['status'], 'deployed')
+        self.assertEqual(engine.items['new']['Config']['HostConfig']['Binds'], [
+            'test-private:/hub/private:rw', 'test-runtime:/run/pi-web-hub:rw',
+            'pi-terminal-provider-ipc:/run/pi-terminal-provider:ro',
+            'pi-terminal-provider-credentials:/run/pi-terminal-credentials:ro'])
+        self.assertEqual(engine.removed, [])
+
+    def test_exact_four_mount_target_survives_future_updates(self):
+        dep, store, engine, job = self.enabled()
+        self.install_mounts(engine)
+        self.assertEqual(dep.check_target()['Id'], 'old')
+        dep.run(job)
+        self.assertEqual(store.get(job['id'])['status'], 'deployed')
+
+    def test_no_optin_rejects_four_mount_target(self):
+        dep, store, engine, job = self.setup_gate()
+        self.install_mounts(engine)
+        with self.assertRaises(ValueError):
+            dep.check_target()
+
+    def test_partial_wrong_name_rw_subpath_and_options_are_rejected(self):
+        for change in ('partial', 'wrong', 'rw', 'subpath', 'bind-rw', 'options-rw'):
+            with self.subTest(change=change):
+                dep, _, engine, _ = self.enabled()
+                self.install_mounts(engine)
+                mounts = engine.items['old']['Mounts']
+                host = engine.items['old']['HostConfig']
+                if change == 'partial': mounts.pop()
+                if change == 'wrong': mounts[-1]['Name'] = 'pi-deploy-gate-state'
+                if change == 'rw': mounts[-1]['RW'] = True
+                if change == 'subpath': mounts[-1]['SubPath'] = 'subdir'
+                if change == 'bind-rw': host['Binds'][-1] = host['Binds'][-1][:-2] + 'rw'
+                if change == 'options-rw':
+                    host['Binds'] = []
+                    host['Mounts'] = [{'Type': 'volume', 'Target': m['Destination'], 'Source': m['Name'],
+                        'ReadOnly': False, 'VolumeOptions': {'NoCopy': True}} for m in mounts]
+                with self.assertRaises(ValueError): dep.check_target()
+
+    def test_health_failure_preserves_legacy_container_and_volumes(self):
+        dep, store, engine, job = self.enabled(True)
+        dep.run(job)
+        self.assertEqual(store.get(job['id'])['status'], 'rolled_back')
+        self.assertEqual(engine.items['old']['Name'], '/test-hub')
+        self.assertTrue(engine.items['old']['State']['Running'])
+        self.assertEqual(len(engine.items['old']['Mounts']), 2)
+        self.assertEqual(engine.removed, [])
+
+    def test_enabled_policy_requires_assets_before_cutover(self):
+        dep, store, engine, job = self.enabled()
+        dep.fetch = lambda _: (b'hub', b'MIT')
+        dep.run(job)
+        self.assertEqual(store.get(job['id'])['status'], 'failed')
+        self.assertEqual(list(engine.items), ['old'])
+        self.assertTrue(engine.items['old']['State']['Running'])
+
+    def test_hostconfig_incomplete_mount_inventory_is_rejected(self):
+        dep, _, engine, _ = self.enabled()
+        self.install_mounts(engine)
+        host = engine.items['old']['HostConfig']
+        host['Binds'] = []
+        host['Mounts'] = [{'Type': 'volume', 'Target': '/hub/private', 'Source': 'test-private',
+            'ReadOnly': False, 'VolumeOptions': {'NoCopy': True}}]
+        with self.assertRaises(ValueError): dep.check_target()
+
+
+class TerminalPolicyTests(unittest.TestCase):
+    def definition(self):
+        return {'id': 'pi-web-hub', 'target': 'pi-web-hub', 'kind': 'hub', 'mode': 'auto',
+            'source': {'repository': 'swordfate3/pi-web-ui', 'auto_branch': 'main'},
+            'policy': {'target': 'pi-web-hub', 'base_image': 'sha256:' + 'a' * 64,
+                'private_volume': 'hub-private', 'runtime_volume': 'hub-runtime',
+                'health_port': 16181, 'health_timeout': 40}}
+
+    def test_only_true_optin_is_accepted_and_old_shape_stays_unchanged(self):
+        value = self.definition()
+        self.assertNotIn('terminal_provider', validate_service(value)['policy'])
+        for bad in (False, 'true', 1, {}, None):
+            value['policy']['terminal_provider'] = bad
+            with self.assertRaises(ValueError): validate_service(value)
+        value['policy']['terminal_provider'] = True
+        self.assertIs(validate_service(value)['policy']['terminal_provider'], True)
+
+    def test_old_job_snapshot_survives_administrator_optin_registration(self):
+        with tempfile.TemporaryDirectory() as directory:
+            store = Store(Path(directory))
+            try:
+                old = store.register_service(self.definition())
+                job = store.request_version('pi-web-hub', {'commit': test_deploy.SHA})
+                definition = self.definition()
+                definition['policy']['terminal_provider'] = True
+                new = store.register_service(definition)
+                self.assertNotEqual(old['policy_hash'], new['policy_hash'])
+                self.assertNotIn('terminal_provider', store.get(job['id'])['snapshot']['policy'])
+            finally: store.close()
+
+    def test_optin_cannot_expose_provider_volume_through_rw_state_role(self):
+        for name in ('pi-terminal-provider-ipc', 'pi-terminal-provider-credentials'):
+            for role in ('private_volume', 'runtime_volume'):
+                for enabled in (False, True):
+                    with self.subTest(name=name,role=role,enabled=enabled):
+                        value = self.definition()
+                        value['policy'][role] = name
+                        if enabled: value['policy']['terminal_provider'] = True
+                        with self.assertRaises(ValueError): validate_service(value)
