+    getConfigFingerprint: () => store.interactionConfigFingerprint(),
+    listAgents: () => manager.listAgents(),
+    visibleAgentTypes: () => [{ name: "general-purpose", description: "Actual source child" }],
+    availableModels: () => [{ key: modelKey, thinkingLevels: ["xhigh", "max"], model }],
+    config: () => ({
+      defaultModel: modelKey,
+      defaultThinking: "xhigh",
+      typeModels: { "general-purpose": modelKey },
+      concurrency: store.concurrency,
+    }),
+    effectiveModel: () => modelKey,
+    setDefaultModel: () => assert.fail("config mutation not expected"),
+    setAgentModel: () => assert.fail("config mutation not expected"),
+    setDefaultThinking: () => assert.fail("config mutation not expected"),
+    setConcurrency: () => assert.fail("config mutation not expected"),
+    spawn: async (intent, signal) => {
+      signal.throwIfAborted();
+      const result = await coordinator.spawn(pi, context, {
+        type: intent.type,
+        prompt: intent.task,
+        description: intent.description,
+        model,
+        modelKey: intent.modelKey,
+        thinkingLevel: intent.thinkingLevel as any,
+        thinkingSource: "manual",
+        graceTurns: store.agent.graceTurns,
+        invocation: {
+          modelName: model.id,
+          thinkingLevel: intent.thinkingLevel as any,
+          runInBackground: intent.runInBackground,
+        },
+        runInBackground: intent.runInBackground,
+      });
+      return { agentId: result.agentId };
+    },
+    interact: async (spec) => {
+      if (spec.action !== "agents.spawn") assert.fail(`unexpected interaction ${spec.action}`);
+      previews.push(spec.content);
+      confirmationStarted();
+      await confirmationGate;
+      return { state: "allowed", answer: true };
+    },
+    revision: () => `real-manager-revision-${++revisionSequence}`,
+  });
+  t.after(() => adapter.dispose());
+
+  const snapshot = await adapter.snapshot();
+  const invokeContext = {
+    actionId: "real-agent-manager-duplicate-action",
+    revision: snapshot.revision,
+    signal: new AbortController().signal,
+  };
+  const params = {
+    type: "general-purpose",
+    task: "  Execute one actual isolated child session  ",
+    description: "  Real AgentManager acceptance  ",
+    model: modelKey,
+    thinking: "xhigh",
+    background: false,
+  };
+
+  const first = adapter.invoke("spawn", params, invokeContext);
+  await confirmationObserved;
+  const duplicate = adapter.invoke("spawn", params, invokeContext);
+  releaseConfirmation();
+  const [firstResult, duplicateResult] = await Promise.all([first, duplicate]);
+  const replayResult = await adapter.invoke("spawn", params, invokeContext);
+
+  assert.deepEqual(duplicateResult, firstResult);
+  assert.deepEqual(replayResult, firstResult);
+  assert.equal(previews.length, 1);
+  assert.deepEqual(previews[0], {
+    method: "spawn",
+    task: "Execute one actual isolated child session",
+    type: "general-purpose",
+    model: modelKey,
+    thinking: "xhigh",
+    background: false,
+    description: "Real AgentManager acceptance",
+    message: "Spawn Subagent with exact parameters",
+  });
+  assert.equal(faux.state.callCount, 1);
+  assert.equal(faux.getPendingResponseCount(), 0);
+  const records = manager.listAgents();
+  assert.equal(records.length, 1);
+  assert.equal((firstResult as { agentId: string }).agentId, records[0].id);
+  assert.equal(records[0].lifecycle.status, "completed");
+  assert.equal(records[0].lifecycle.started, true);
+  assert.equal(records[0].execution.settlementCount, 1);
+  assert.ok(records[0].execution.session instanceof sdk.AgentSession);
+  assert.equal(records[0].result, "REAL_CHILD_COMPLETED");
+});
