+import { randomBytes } from "node:crypto";
+
+export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+
+type InteractionSpec = {
+  action: string;
+  revision: string;
+  classification: "session" | "sensitive";
+  method: "confirm" | "select" | "input" | "editor";
+  schema: { kind: "confirm" } | { kind: "select"; options: string[] } | { kind: "text"; maxBytes: number };
+  content: Record<string, Json>;
+  deadline: number;
+};
+
+type InteractionResult = {
+  state: "pending" | "delivering" | "allowed" | "rejected" | "cancelled" | "expired" | "stale" | "delivery_unknown";
+  answer?: boolean | string;
+};
+
+type InvokeContext = { actionId: string; revision: string; signal: AbortSignal };
+type PanelSnapshot = {
+  revision: string;
+  items: Record<string, Json>[];
+  cursor?: string | null;
+  config?: Record<string, Json>;
+};
+
+type ConfigTarget = "session" | "global" | "project";
+type ThinkingTarget = "global" | "project";
+type ModelChoice = { key: string; thinkingLevels: string[]; model?: unknown };
+
+export interface AgentsInteractionDependencies {
+  packageVersion: string;
+  isCurrent(): boolean;
+  getConfigFingerprint(): string;
+  listAgents(): Array<Record<string, any>>;
+  visibleAgentTypes(): Array<{ name: string; description: string }>;
+  availableModels(): ModelChoice[];
+  config(): {
+    defaultModel: string | null;
+    defaultThinking: string | null;
+    typeModels: Record<string, string>;
+    concurrency: { default: number; providers: Record<string, number>; models: Record<string, number> };
+  };
+  effectiveModel(type: string): string;
+  setDefaultModel(model: string | null, target: ConfigTarget): void;
+  setAgentModel(type: string, model: string | null, target: ConfigTarget): void;
+  setDefaultThinking(thinking: string | null, target: ThinkingTarget): void;
+  setConcurrency(scope: "default" | "provider" | "model", key: string | undefined, value: number, target: ConfigTarget): void;
+  spawn(intent: {
+    type: string;
+    task: string;
+    description: string;
+    modelKey: string;
+    model?: unknown;
+    thinkingLevel?: string;
+    thinkingSource: "manual";
+    runInBackground: boolean;
+  }, signal: AbortSignal): Promise<{ agentId: string }>;
+  interact?: (
+    spec: InteractionSpec,
+    options: {
+      signal?: AbortSignal;
+      isCurrent: () => boolean;
+      local?: (signal: AbortSignal) => Promise<boolean | string | undefined>;
+    },
+  ) => Promise<InteractionResult>;
+  confirm?: (message: string, signal: AbortSignal) => Promise<boolean | undefined>;
+  revision?: () => string;
+  now?: () => number;
+}
+
+type PublicInteractionModule = {
+  createInteractionClient?: (events: unknown, manifest: Record<string, unknown>) => {
+    interact: AgentsInteractionDependencies["interact"];
+    dispose(): void;
+  };
+  registerInteractionPanel?: (
+    events: unknown,
+    options: {
+      manifest: { id: string; version: string; packageName: string; commands: string[]; methods: string[] };
+      isCurrent: () => boolean;
+      snapshot: (cursor?: string) => Promise<PanelSnapshot>;
+      invoke: (method: string, params: Record<string, Json>, context: InvokeContext) => Promise<Json>;
+    },
+  ) => { dispose(): void };
+};
+
+export type InteractionModuleLoader = () => Promise<PublicInteractionModule | undefined>;
+
+const PACKAGE_NAME = "pi-subagents-lite";
+const METHODS = ["set-default-model", "set-agent-model", "set-default-thinking", "set-concurrency", "spawn"];
+const MAX_SPAWN_RECEIPTS = 128;
+const PANEL_PAGE_SIZE = 100;
+
+function pageOffset(cursor?: string): number {
+  if (cursor === undefined) return 0;
+  if (!/^(0|[1-9][0-9]*)$/.test(cursor)) throw new Error("Invalid Subagents panel cursor");
+  const offset = Number(cursor);
+  if (!Number.isSafeInteger(offset)) throw new Error("Invalid Subagents panel cursor");
+  return offset;
+}
+
+function plainRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function exactKeys(params: Record<string, Json>, required: string[], optional: string[] = []): void {
+  if (!plainRecord(params)
+    || required.some((key) => !Object.hasOwn(params, key))
+    || Object.keys(params).some((key) => !required.includes(key) && !optional.includes(key))) {
+    throw new Error("Invalid Subagents panel parameters");
+  }
+}
+
+function target(value: Json): ConfigTarget {
+  if (value === "session" || value === "global" || value === "project") return value;
+  throw new Error("Invalid Subagents config target");
+}
+
+function exactLocalApprovalMessage(label: string, intent: Record<string, Json>): string {
+  return `${label}:\n${JSON.stringify(intent, null, 2)}`;
+}
+
+class RevisionGate {
+  private fingerprint: string | undefined;
+  private value: string | undefined;
+  private readonly read: () => string;
+  private readonly generate: () => string;
+
+  constructor(read: () => string, generate: () => string) {
+    this.read = read;
+    this.generate = generate;
+  }
+
+  current(): string {
+    const fingerprint = this.read();
+    if (this.fingerprint !== fingerprint || this.value === undefined) {
+      this.fingerprint = fingerprint;
+      this.value = this.generate();
+    }
+    return this.value;
+  }
+
+  assert(expected: string): void {
+    if (this.current() !== expected) throw new Error("Stale Subagents configuration revision");
+  }
+
+  invalidate(): void {
+    this.fingerprint = undefined;
+    this.value = undefined;
+  }
+}
+
+export function createAgentsInteractionAdapter(deps: AgentsInteractionDependencies) {
+  const revision = new RevisionGate(deps.getConfigFingerprint, deps.revision ?? (() => randomBytes(16).toString("hex")));
+  const receipts = new Map<string, { promise: Promise<Json>; settled: boolean }>();
+  const now = deps.now ?? Date.now;
+  let disposed = false;
+
+  const isCurrent = () => !disposed && deps.isCurrent();
+  const guard = () => {
+    if (!isCurrent()) throw new Error("Stale Subagents runtime");
+  };
+  const interact = async (spec: InteractionSpec, signal: AbortSignal, localMessage: string) => {
+    if (!deps.interact) throw new Error("Subagents Web interaction client unavailable");
+    return deps.interact(spec, {
+      signal,
+      isCurrent,
+      ...(deps.confirm ? { local: (localSignal: AbortSignal) => deps.confirm!(localMessage, localSignal) } : {}),
+    });
+  };
+  const confirm = async (
+    action: "agents.config" | "agents.spawn",
+    label: string,
+    intent: Record<string, Json>,
+    expected: string,
+    signal: AbortSignal,
+  ) => {
+    const content = { ...intent, message: label };
+    const result = await interact({
+      action,
+      revision: expected,
+      classification: "sensitive",
+      method: "confirm",
+      schema: { kind: "confirm" },
+      content,
+      deadline: now() + 120_000,
+    }, signal, exactLocalApprovalMessage(label, intent));
+    return result.state === "allowed" && result.answer === true;
+  };
+  const currentTypes = () => deps.visibleAgentTypes();
+  const currentModels = () => deps.availableModels();
+  const findModel = (key: string) => currentModels().find((choice) => choice.key === key);
+  const requireModel = (value: Json, allowNull: boolean): string | null => {
+    if (allowNull && value === null) return null;
+    if (typeof value !== "string" || !findModel(value)) throw new Error("Model is not in the current available model list");
+    return value;
+  };
+  const trimReceipts = () => {
+    while (receipts.size >= MAX_SPAWN_RECEIPTS) {
+      const settled = [...receipts.entries()].find(([, entry]) => entry.settled);
+      if (!settled) throw new Error("Too many pending Subagents spawn actions");
+      receipts.delete(settled[0]);
+    }
+  };
+
+  const manifest = {
+    id: PACKAGE_NAME,
+    version: deps.packageVersion,
+    packageName: PACKAGE_NAME,
+    commands: ["agents"],
+    methods: [...METHODS],
+  };
+
+  return {
+    manifest,
+    isCurrent,
+    async snapshot(cursor?: string): Promise<PanelSnapshot> {
+      guard();
+      const models = currentModels().map(({ key, thinkingLevels }) => ({ key, thinkingLevels: [...thinkingLevels] }));
+      const agentTypes = currentTypes().map(({ name, description }) => ({ name, description, effectiveModel: deps.effectiveModel(name) }));
+      const config = deps.config();
+      const allItems = deps.listAgents()
+        .filter((record) => record.lifecycle?.status === "running" || record.lifecycle?.status === "queued")
+        .map((record) => ({
+          id: String(record.id),
+          status: String(record.lifecycle?.status ?? "unknown"),
+          type: String(record.display?.type ?? "unknown"),
+          description: String(record.display?.description ?? ""),
+          startedAt: Number(record.lifecycle?.startedAt ?? 0),
+          ...(record.lifecycle?.completedAt !== undefined ? { completedAt: Number(record.lifecycle.completedAt) } : {}),
+          ...((record.execution?.modelKey ?? record.display?.invocation?.modelName) ? { model: String(record.execution?.modelKey ?? record.display.invocation.modelName) } : {}),
+          ...(record.display?.invocation?.thinkingLevel ? { thinking: String(record.display.invocation.thinkingLevel) } : {}),
+          ...(typeof record.display?.invocation?.runInBackground === "boolean" ? { background: record.display.invocation.runInBackground } : {}),
+        } satisfies Record<string, Json>));
+      const offset = pageOffset(cursor);
+      if (offset > allItems.length) throw new Error("Invalid Subagents panel cursor");
+      const items = allItems.slice(offset, offset + PANEL_PAGE_SIZE);
+      const nextOffset = offset + items.length;
+      return {
+        revision: revision.current(),
+        items,
+        cursor: nextOffset < allItems.length ? String(nextOffset) : null,
+        config: {
+          agentTypes,
+          models,
+          defaultModel: config.defaultModel,
+          defaultThinking: config.defaultThinking,
+          typeModels: { ...config.typeModels },
+          concurrency: {
+            default: config.concurrency.default,
+            providers: { ...config.concurrency.providers },
+            models: { ...config.concurrency.models },
+          },
+        },
+      };
+    },
+    async invoke(method: string, params: Record<string, Json>, context: InvokeContext): Promise<Json> {
+      guard();
+      if (!METHODS.includes(method)) throw new Error("Unknown Subagents panel method");
+      if (!context.actionId.trim()) throw new Error("Subagents action id is required");
+      if (context.signal.aborted) context.signal.throwIfAborted();
+
+      if (method === "spawn") {
+        const duplicate = receipts.get(context.actionId);
+        if (duplicate) return duplicate.promise;
+        exactKeys(params, ["type", "task"], ["description", "model", "thinking", "background"]);
+        if (typeof params.type !== "string" || !currentTypes().some(({ name }) => name === params.type)) {
+          throw new Error("Spawn type must be an exact currently visible agent type");
+        }
+        if (typeof params.task !== "string" || !params.task.trim() || Buffer.byteLength(params.task) > 32 * 1024) {
+          throw new Error("Spawn task must be nonblank and no larger than 32 KiB");
+        }
+        if (params.description !== undefined && (typeof params.description !== "string" || !params.description.trim() || params.description.length > 256)) {
+          throw new Error("Spawn description must be nonblank and at most 256 characters");
+        }
+        if (params.background !== undefined && typeof params.background !== "boolean") throw new Error("Invalid spawn background value");
+        const modelKey = params.model === undefined ? deps.effectiveModel(params.type) : requireModel(params.model, false)!;
+        const selected = findModel(modelKey);
+        if (!selected) throw new Error("Spawn model is not in the current available model list");
+        const thinking = params.thinking;
+        if (thinking !== undefined && (typeof thinking !== "string" || !selected.thinkingLevels.includes(thinking))) {
+          throw new Error("Spawn thinking level is not allowed for the selected model");
+        }
+        revision.assert(context.revision);
+        trimReceipts();
+        const spawnType = params.type;
+        const spawnTask = params.task.trim();
+        const spawnDescription = typeof params.description === "string" ? params.description.trim() : spawnTask.slice(0, 50);
+        const spawnThinking = typeof thinking === "string" ? thinking : undefined;
+        const spawnBackground = params.background !== false;
+
+        let resolveReceipt!: (value: Json) => void;
+        let rejectReceipt!: (reason: unknown) => void;
+        const promise = new Promise<Json>((resolve, reject) => {
+          resolveReceipt = resolve;
+          rejectReceipt = reject;
+        });
+        const receipt = { promise, settled: false };
+        receipts.set(context.actionId, receipt);
+
+        void (async (): Promise<Json> => {
+          const intent = {
+            method: "spawn",
+            type: spawnType,
+            task: spawnTask,
+            description: spawnDescription,
+            model: modelKey,
+            thinking: spawnThinking ?? null,
+            background: spawnBackground,
+          } satisfies Record<string, Json>;
+          if (!await confirm(
+            "agents.spawn",
+            "Spawn Subagent with exact parameters",
+            intent,
+            context.revision,
+            context.signal,
+          )) {
+            return { ok: false, cancelled: true };
+          }
+          context.signal.throwIfAborted();
+          guard();
+          revision.assert(context.revision);
+          const freshType = currentTypes().find(({ name }) => name === spawnType);
+          const freshModel = findModel(modelKey);
+          if (!freshType) throw new Error("Spawn type is no longer a visible agent type");
+          if (!freshModel) throw new Error("Spawn model is no longer available");
+          if (spawnThinking !== undefined && !freshModel.thinkingLevels.includes(spawnThinking)) {
+            throw new Error("Spawn thinking level is no longer allowed for the selected model");
+          }
+          const result = await deps.spawn({
+            type: freshType.name,
+            task: spawnTask,
+            description: spawnDescription,
+            modelKey: freshModel.key,
+            ...(freshModel.model !== undefined ? { model: freshModel.model } : {}),
+            ...(spawnThinking !== undefined ? { thinkingLevel: spawnThinking } : {}),
+            thinkingSource: "manual",
+            runInBackground: spawnBackground,
+          }, context.signal);
+          return { ok: true, agentId: result.agentId };
+        })().then(resolveReceipt, rejectReceipt).finally(() => { receipt.settled = true; });
+        return promise;
+      }
+
+      revision.assert(context.revision);
+      if (method === "set-default-model") {
+        exactKeys(params, ["model", "target"]);
+        const model = requireModel(params.model, true);
+        const mutationTarget = target(params.target);
+        if (!await confirm("agents.config", "Change Subagents settings with exact parameters", {
+          method: "set-default-model",
+          model,
+          target: mutationTarget,
+        }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        deps.setDefaultModel(model, mutationTarget);
+      } else if (method === "set-agent-model") {
+        exactKeys(params, ["type", "model", "target"]);
+        if (typeof params.type !== "string" || !currentTypes().some(({ name }) => name === params.type)) throw new Error("Model override requires an exact visible agent type");
+        const model = requireModel(params.model, true);
+        const mutationTarget = target(params.target);
+        if (!await confirm("agents.config", "Change Subagents settings with exact parameters", {
+          method: "set-agent-model",
+          type: params.type,
+          model,
+          target: mutationTarget,
+        }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        deps.setAgentModel(params.type, model, mutationTarget);
+      } else if (method === "set-default-thinking") {
+        exactKeys(params, ["thinking", "target"]);
+        const levels = new Set(currentModels().flatMap(({ thinkingLevels }) => thinkingLevels));
+        const thinking = params.thinking;
+        if (thinking !== null && (typeof thinking !== "string" || (thinking !== "parent" && !levels.has(thinking)))) {
+          throw new Error("Default thinking is not in the current supported choices");
+        }
+        if (params.target !== "global" && params.target !== "project") throw new Error("Default thinking target must be global or project");
+        if (!await confirm("agents.config", "Change Subagents settings with exact parameters", {
+          method: "set-default-thinking",
+          thinking,
+          target: params.target,
+        }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        deps.setDefaultThinking(thinking, params.target);
+      } else {
+        exactKeys(params, ["scope", "value", "target"], ["key"]);
+        if (params.scope !== "default" && params.scope !== "provider" && params.scope !== "model") throw new Error("Invalid concurrency scope");
+        if (typeof params.value !== "number" || !Number.isSafeInteger(params.value) || params.value < 1) {
+          throw new Error("Concurrency value must be a positive safe integer");
+        }
+        const mutationTarget = target(params.target);
+        let key: string | undefined;
+        if (params.scope !== "default") {
+          if (typeof params.key !== "string" || !params.key) throw new Error("Concurrency key is required");
+          key = params.key;
+          const models = currentModels();
+          if (params.scope === "model" && !models.some((model) => model.key === key)) throw new Error("Concurrency model is not currently available");
+          if (params.scope === "provider" && !models.some((model) => model.key.split("/")[0] === key)) throw new Error("Concurrency provider is not currently available");
+        } else if (params.key !== undefined) {
+          throw new Error("Default concurrency does not accept a key");
+        }
+        if (!await confirm("agents.config", "Change Subagents settings with exact parameters", {
+          method: "set-concurrency",
+          scope: params.scope,
+          key: key ?? null,
+          value: params.value,
+          target: mutationTarget,
+        }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        deps.setConcurrency(params.scope, key, params.value, mutationTarget);
+      }
+      revision.invalidate();
+      return {
+        ok: true,
+        appliesTo: method === "set-concurrency" ? "future-and-queued-scheduling" : "future-spawns",
+        runningAgentsRestarted: false,
+      };
+    },
+    dispose() {
+      disposed = true;
+      revision.invalidate();
+      receipts.clear();
+    },
+  };
+}
+
+async function importPublicInteractions(): Promise<PublicInteractionModule | undefined> {
+  try {
+    // Keep import visible to Pi's Jiti evaluator; Function-created imports have
+    // no dynamic-import callback inside its VM context.
+    const specifier = "@kkkiio/pi-web-ui/interactions/v1";
+    return await import(specifier);
+  } catch (error) {
+    const code = (error as { code?: unknown })?.code;
+    if (code === "ERR_MODULE_NOT_FOUND" || code === "ERR_PACKAGE_PATH_NOT_EXPORTED") return undefined;
+    if (code === "MODULE_NOT_FOUND" && error instanceof Error &&
+        error.message.split("\n")[0] === "Cannot find module '@kkkiio/pi-web-ui/interactions/v1'") return undefined;
+    throw error;
+  }
+}
+
+export async function installAgentsInteractionPanel(
+  events: unknown,
+  dependencies: AgentsInteractionDependencies,
+  load: InteractionModuleLoader = importPublicInteractions,
+): Promise<{ dispose(): void } | undefined> {
+  const api = await load();
+  if (typeof api?.createInteractionClient !== "function" || typeof api.registerInteractionPanel !== "function") return undefined;
+  const client = api.createInteractionClient(events, {
+    id: PACKAGE_NAME,
+    version: dependencies.packageVersion,
+    packageName: PACKAGE_NAME,
+    actions: {
+      "agents.config": { classification: "sensitive", method: "confirm" },
+      "agents.spawn": { classification: "sensitive", method: "confirm" },
+    },
+  });
+  const interact = client.interact;
+  if (typeof interact !== "function") {
+    client.dispose();
+    return undefined;
+  }
+  const adapter = createAgentsInteractionAdapter({ ...dependencies, interact });
+  let panel: { dispose(): void };
+  try {
+    panel = api.registerInteractionPanel(events, {
+      manifest: adapter.manifest,
+      isCurrent: adapter.isCurrent,
+      snapshot: adapter.snapshot,
+      invoke: adapter.invoke,
+    });
+  } catch (error) {
+    adapter.dispose();
+    client.dispose();
+    throw error;
+  }
+  return {
+    dispose() {
+      panel.dispose();
+      adapter.dispose();
+      client.dispose();
+    },
+  };
+}
