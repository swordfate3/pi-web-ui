diff --git a/extensions/pi-web-ui-interactions-v1.d.ts b/extensions/pi-web-ui-interactions-v1.d.ts
new file mode 100644
--- /dev/null
+++ b/extensions/pi-web-ui-interactions-v1.d.ts
@@ -0,0 +1,71 @@
+declare module "@kkkiio/pi-web-ui/interactions/v1" {
+  export type Json =
+    | null
+    | boolean
+    | number
+    | string
+    | Json[]
+    | { [key: string]: Json };
+  export type ResponseSchema =
+    | { kind: "confirm" }
+    | { kind: "select"; options: string[] }
+    | { kind: "text"; maxBytes: number };
+  export type InteractionSpec = {
+    action: string;
+    revision: string;
+    classification: "session" | "sensitive";
+    method: "confirm" | "select" | "input" | "editor";
+    schema: ResponseSchema;
+    purpose?: "oauth";
+    content: Record<string, Json>;
+    deadline: number;
+  };
+  export type InteractionResult = {
+    state:
+      | "pending"
+      | "delivering"
+      | "allowed"
+      | "rejected"
+      | "cancelled"
+      | "expired"
+      | "stale"
+      | "delivery_unknown";
+    winner?: "local" | "web";
+    answer?: boolean | string;
+  };
+  export type SourceRequestOptions = {
+    isCurrent: () => boolean;
+    signal?: AbortSignal;
+    local?: (signal: AbortSignal) => Promise<boolean | string | undefined>;
+    operationId?: string;
+  };
+  export type AdapterManifest = {
+    id: string;
+    version: string;
+    packageName: string;
+    actions: Record<
+      string,
+      {
+        classification: InteractionSpec["classification"];
+        method: InteractionSpec["method"];
+      }
+    >;
+  };
+  export type InteractionEventBus = {
+    emit(channel: string, data: unknown): void;
+    on(channel: string, handler: (data: unknown) => void): () => void;
+  };
+  export type InteractionClient = {
+    status(): "absent" | "unsupported" | "available";
+    interact(
+      spec: InteractionSpec,
+      options: SourceRequestOptions,
+    ): Promise<InteractionResult>;
+    request(spec: InteractionSpec, options: SourceRequestOptions): unknown;
+    dispose(): void;
+  };
+  export function createInteractionClient(
+    events: InteractionEventBus,
+    manifest: AdapterManifest,
+  ): InteractionClient;
+}
