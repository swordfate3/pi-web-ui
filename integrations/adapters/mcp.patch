+import { randomBytes } from "node:crypto";
+
+export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+
+type InteractionSpec = {
+  action: string;
+  revision: string;
+  classification: "session" | "sensitive";
+  method: "confirm" | "select" | "input" | "editor";
+  schema: { kind: "confirm" } | { kind: "select"; options: string[] } | { kind: "text"; maxBytes: number };
+  purpose?: "oauth";
+  content: Record<string, Json>;
+  deadline: number;
+};
+
+type InteractionResult = {
+  state: "pending" | "delivering" | "allowed" | "rejected" | "cancelled" | "expired" | "stale" | "delivery_unknown";
+  answer?: boolean | string;
+};
+
+type InvokeContext = { actionId: string; revision: string; signal: AbortSignal };
+type PanelSnapshot = {
+  revision: string;
+  items: Record<string, Json>[];
+  cursor?: string | null;
+  config?: Record<string, Json>;
+};
+
+type McpStatus = {
+  version: number;
+  servers: ReadonlyArray<{
+    name: string;
+    status: string;
+    listenState: string;
+    toolCount: number;
+    directToolCount: number;
+    resourceCount?: number;
+    failedAgoSeconds?: number;
+    disabled: boolean;
+    catalogStale?: boolean;
+    blockedReason?: string;
+  }>;
+  totalTools: number;
+  totalResources: number;
+  connectedCount: number;
+  disabledCount: number;
+};
+
+export type McpExecutionPreview =
+  | { transport: "stdio"; command: string; args: string[]; cwd: string | null }
+  | { transport: "http"; url: string }
+  | { transport: "unix-socket"; socket: string };
+
+export type McpInteractionBinding = {
+  configFingerprint: string;
+  runtimeFingerprint: string;
+  execution: McpExecutionPreview;
+};
+
+export interface McpInteractionDependencies {
+  packageVersion: string;
+  ownsMcpCommand: boolean;
+  isCurrent(): boolean;
+  getConfigFingerprint(): string;
+  getRuntimeFingerprint(): string;
+  getExecutionPreview(name: string): McpExecutionPreview;
+  getStatus(): McpStatus;
+  hasServer(name: string): boolean;
+  isProgrammaticConfig(): boolean;
+  reconnect(name: string, signal: AbortSignal, binding: McpInteractionBinding): Promise<boolean>;
+  setDisabled(name: string, disabled: boolean): { changed: boolean; path: string };
+  oauth(
+    name: string,
+    input: (authorizationUrl: string) => Promise<string | undefined>,
+    signal: AbortSignal,
+    binding: McpInteractionBinding,
+  ): Promise<{ authenticated: boolean; reconnected: boolean }>;
+  interact?: (
+    spec: InteractionSpec,
+    options: {
+      signal?: AbortSignal;
+      isCurrent: () => boolean;
+      local?: (signal: AbortSignal) => Promise<boolean | string | undefined>;
+    },
+  ) => Promise<InteractionResult>;
+  confirm?: (message: string, signal: AbortSignal) => Promise<boolean | undefined>;
+  oauthLocalInput?: (authorizationUrl: string, signal: AbortSignal) => Promise<string | undefined>;
+  revision?: () => string;
+  now?: () => number;
+}
+
+type PublicInteractionModule = {
+  createInteractionClient?: (events: unknown, manifest: Record<string, unknown>) => {
+    interact: McpInteractionDependencies["interact"];
+    dispose(): void;
+  };
+  registerInteractionPanel?: (
+    events: unknown,
+    options: {
+      manifest: { id: string; version: string; packageName: string; commands: string[]; methods: string[] };
+      isCurrent: () => boolean;
+      snapshot: (cursor?: string) => Promise<PanelSnapshot>;
+      invoke: (method: string, params: Record<string, Json>, context: InvokeContext) => Promise<Json>;
+    },
+  ) => { dispose(): void };
+};
+
+export type InteractionModuleLoader = () => Promise<PublicInteractionModule | undefined>;
+
+const PACKAGE_NAME = "pi-mcp-adapter";
+const METHODS = ["reconnect", "enable", "disable", "oauth"];
+const PANEL_PAGE_SIZE = 100;
+
+function pageOffset(cursor?: string): number {
+  if (cursor === undefined) return 0;
+  if (!/^(0|[1-9][0-9]*)$/.test(cursor)) throw new Error("Invalid MCP panel cursor");
+  const offset = Number(cursor);
+  if (!Number.isSafeInteger(offset)) throw new Error("Invalid MCP panel cursor");
+  return offset;
+}
+
+function plainRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function serverName(params: Record<string, Json>): string {
+  if (!plainRecord(params) || Object.keys(params).length !== 1 || typeof params.name !== "string" || !params.name.trim()) {
+    throw new Error("Invalid MCP panel parameters");
+  }
+  return params.name;
+}
+
+class RevisionGate {
+  private fingerprint: string | undefined;
+  private value: string | undefined;
+  private readonly read: () => string;
+  private readonly generate: () => string;
+
+  constructor(read: () => string, generate: () => string) {
+    this.read = read;
+    this.generate = generate;
+  }
+
+  current(): string {
+    const fingerprint = this.read();
+    if (this.fingerprint !== fingerprint || this.value === undefined) {
+      this.fingerprint = fingerprint;
+      this.value = this.generate();
+    }
+    return this.value;
+  }
+
+  assert(expected: string): void {
+    if (this.current() !== expected) throw new Error("Stale MCP configuration revision");
+  }
+
+  invalidate(): void {
+    this.fingerprint = undefined;
+    this.value = undefined;
+  }
+}
+
+function interactionAllowed(result: InteractionResult): boolean {
+  return result.state === "allowed" && result.answer === true;
+}
+
+function exactLocalApprovalMessage(label: string, intent: Record<string, Json>): string {
+  return `${label}:\n${JSON.stringify(intent, null, 2)}`;
+}
+
+export function createMcpInteractionAdapter(deps: McpInteractionDependencies) {
+  const revision = new RevisionGate(
+    () => JSON.stringify([deps.getConfigFingerprint(), deps.getRuntimeFingerprint()]),
+    deps.revision ?? (() => randomBytes(16).toString("hex")),
+  );
+  const now = deps.now ?? Date.now;
+  let disposed = false;
+
+  const isCurrent = () => !disposed && deps.isCurrent();
+  const guard = () => {
+    if (!isCurrent()) throw new Error("Stale MCP runtime");
+  };
+  const interact = async (spec: InteractionSpec, local?: (signal: AbortSignal) => Promise<boolean | string | undefined>, signal?: AbortSignal) => {
+    if (!deps.interact) throw new Error("MCP Web interaction client unavailable");
+    return deps.interact(spec, { signal, isCurrent, ...(local ? { local } : {}) });
+  };
+  const binding = (name: string): McpInteractionBinding => ({
+    configFingerprint: deps.getConfigFingerprint(),
+    runtimeFingerprint: deps.getRuntimeFingerprint(),
+    execution: deps.getExecutionPreview(name),
+  });
+  const confirm = async (
+    action: "mcp.reconnect" | "mcp.config",
+    intent: Record<string, Json>,
+    expected: string,
+    signal: AbortSignal,
+  ) => {
+    const label = action === "mcp.reconnect"
+      ? "Reconnect MCP server with exact parameters"
+      : `${intent.method === "disable" ? "Disable" : "Enable"} MCP server with exact parameters`;
+    const content = { ...intent, message: label };
+    const localMessage = exactLocalApprovalMessage(label, intent);
+    const result = await interact({
+      action,
+      revision: expected,
+      classification: "sensitive",
+      method: "confirm",
+      schema: { kind: "confirm" },
+      content,
+      deadline: now() + 120_000,
+    }, deps.confirm ? (localSignal) => deps.confirm!(localMessage, localSignal) : undefined, signal);
+    return interactionAllowed(result);
+  };
+
+  const manifest = {
+    id: PACKAGE_NAME,
+    version: deps.packageVersion,
+    packageName: PACKAGE_NAME,
+    commands: ["mcp-adapter", "mcp-auth", ...(deps.ownsMcpCommand ? ["mcp"] : [])],
+    methods: [...METHODS],
+  };
+
+  return {
+    manifest,
+    isCurrent,
+    async snapshot(cursor?: string): Promise<PanelSnapshot> {
+      guard();
+      const status = deps.getStatus();
+      const allItems = status.servers.map((server) => ({
+        name: server.name,
+        status: server.status,
+        listenState: server.listenState,
+        toolCount: server.toolCount,
+        directToolCount: server.directToolCount,
+        ...(server.resourceCount !== undefined ? { resourceCount: server.resourceCount } : {}),
+        ...(server.failedAgoSeconds !== undefined ? { failedAgoSeconds: server.failedAgoSeconds } : {}),
+        disabled: server.disabled,
+        ...(server.catalogStale === true ? { catalogStale: true } : {}),
+        ...(server.blockedReason ? { blockedReason: server.blockedReason } : {}),
+      } satisfies Record<string, Json>));
+      const offset = pageOffset(cursor);
+      if (offset > allItems.length) throw new Error("Invalid MCP panel cursor");
+      const items = allItems.slice(offset, offset + PANEL_PAGE_SIZE);
+      const nextOffset = offset + items.length;
+      return {
+        revision: revision.current(),
+        items,
+        cursor: nextOffset < allItems.length ? String(nextOffset) : null,
+        config: {
+          ownsMcpCommand: deps.ownsMcpCommand,
+          programmaticConfig: deps.isProgrammaticConfig(),
+          totalTools: status.totalTools,
+          totalResources: status.totalResources,
+          connectedCount: status.connectedCount,
+          disabledCount: status.disabledCount,
+        },
+      };
+    },
+    async invoke(method: string, params: Record<string, Json>, context: InvokeContext): Promise<Json> {
+      guard();
+      if (!METHODS.includes(method)) throw new Error("Unknown MCP panel method");
+      if (!context.actionId.trim()) throw new Error("MCP action id is required");
+      if (context.signal.aborted) context.signal.throwIfAborted();
+      revision.assert(context.revision);
+      const name = serverName(params);
+      if (!deps.hasServer(name)) throw new Error("MCP server is not present in the current configuration");
+
+      if (method === "reconnect") {
+        const approvedBinding = binding(name);
+        if (!await confirm("mcp.reconnect", { method, name, execution: approvedBinding.execution }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        return { ok: await deps.reconnect(name, context.signal, approvedBinding) };
+      }
+
+      if (method === "enable" || method === "disable") {
+        if (deps.isProgrammaticConfig()) throw new Error("MCP enabled state is read-only for programmatic configuration");
+        if (!await confirm("mcp.config", { method, name, disabled: method === "disable" }, context.revision, context.signal)) return { ok: false, cancelled: true };
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        const result = deps.setDisabled(name, method === "disable");
+        revision.invalidate();
+        return { ok: true, changed: result.changed, reloadRequired: result.changed };
+      }
+
+      const approvedBinding = binding(name);
+      const oauth = await deps.oauth(name, async (authorizationUrl) => {
+        guard();
+        revision.assert(context.revision);
+        const result = await interact({
+          action: "mcp.oauth",
+          revision: context.revision,
+          classification: "sensitive",
+          method: "input",
+          schema: { kind: "text", maxBytes: 32 * 1024 },
+          purpose: "oauth",
+          content: {
+            method: "oauth",
+            name,
+            authorizationUrl,
+            message: "Approve access, then paste the full callback URL from the browser address bar.",
+          },
+          deadline: now() + 600_000,
+        }, deps.oauthLocalInput ? (localSignal) => deps.oauthLocalInput!(authorizationUrl, localSignal) : undefined, context.signal);
+        context.signal.throwIfAborted();
+        guard();
+        revision.assert(context.revision);
+        return result.state === "allowed" && typeof result.answer === "string" ? result.answer : undefined;
+      }, context.signal, approvedBinding);
+      guard();
+      return { ok: oauth.authenticated, authenticated: oauth.authenticated, reconnected: oauth.reconnected };
+    },
+    dispose() {
+      disposed = true;
+      revision.invalidate();
+    },
+  };
+}
+
+async function importPublicInteractions(): Promise<PublicInteractionModule | undefined> {
+  try {
+    // Keep import visible to Pi's Jiti evaluator; Function-created imports have
+    // no dynamic-import callback inside its VM context.
+    const specifier = "@kkkiio/pi-web-ui/interactions/v1";
+    return await import(specifier);
+  } catch (error) {
+    const code = (error as { code?: unknown })?.code;
+    if (code === "ERR_MODULE_NOT_FOUND" || code === "ERR_PACKAGE_PATH_NOT_EXPORTED") return undefined;
+    if (code === "MODULE_NOT_FOUND" && error instanceof Error &&
+        error.message.split("\n")[0] === "Cannot find module '@kkkiio/pi-web-ui/interactions/v1'") return undefined;
+    throw error;
+  }
+}
+
+/** An installed cooperative API needs source state even when all servers stay lazy. */
+export async function hasMcpInteractionApi(): Promise<boolean> {
+  const api = await importPublicInteractions();
+  return typeof api?.createInteractionClient === "function" && typeof api.registerInteractionPanel === "function";
+}
+
+export async function installMcpInteractionPanel(
+  events: unknown,
+  dependencies: McpInteractionDependencies,
+  load: InteractionModuleLoader = importPublicInteractions,
+): Promise<{ dispose(): void } | undefined> {
+  const api = await load();
+  if (typeof api?.createInteractionClient !== "function" || typeof api.registerInteractionPanel !== "function") return undefined;
+  const client = api.createInteractionClient(events, {
+    id: PACKAGE_NAME,
+    version: dependencies.packageVersion,
+    packageName: PACKAGE_NAME,
+    actions: {
+      "mcp.reconnect": { classification: "sensitive", method: "confirm" },
+      "mcp.config": { classification: "sensitive", method: "confirm" },
+      "mcp.oauth": { classification: "sensitive", method: "input" },
+    },
+  });
+  const interact = client.interact;
+  if (typeof interact !== "function") {
+    client.dispose();
+    return undefined;
+  }
+  const adapter = createMcpInteractionAdapter({ ...dependencies, interact });
+  let panel: { dispose(): void };
+  try {
+    panel = api.registerInteractionPanel(events, {
+      manifest: adapter.manifest,
+      isCurrent: adapter.isCurrent,
+      snapshot: adapter.snapshot,
+      invoke: adapter.invoke,
+    });
+  } catch (error) {
+    adapter.dispose();
+    client.dispose();
+    throw error;
+  }
+  return {
+    dispose() {
+      panel.dispose();
+      adapter.dispose();
+      client.dispose();
+    },
+  };
+}
