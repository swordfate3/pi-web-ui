+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { setImmediate } from "node:timers/promises";
+
+async function waitFor(check: () => boolean, message: string): Promise<void> {
+  for (let attempt = 0; attempt < 200; attempt++) {
+    if (check()) return;
+    await setImmediate();
+  }
+  assert.fail(message);
+}
+
+for (const scenario of ["disabled", "lazy", "direct-lazy", "concurrent"] as const) {
+test(`the real MCP index factory registers a source panel with ${scenario} startup through the actual SDK event bus`, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pi-mcp-index-acceptance-"));
+  const agentDir = join(root, "agent");
+  const projectDir = join(root, "project");
+  await mkdir(agentDir, { recursive: true });
+  await mkdir(projectDir, { recursive: true });
+  await writeFile(join(agentDir, "mcp-adapter.json"), JSON.stringify({
+    settings: { deferWithMissingMetadata: true, ...(scenario === "direct-lazy" ? { directTools: true } : {}) },
+    mcpServers: {
+      "disabled-acceptance": {
+        command: "this-command-must-never-run",
+        disabled: true,
+      },
+      ...(scenario === "lazy" || scenario === "direct-lazy" ? {
+        "enabled-lazy": { command: "this-command-must-never-run", lifecycle: "lazy" },
+      } : {}),
+    },
+  }));
+
+  const priorHome = process.env.HOME;
+  const priorAgentDir = process.env.PI_CODING_AGENT_DIR;
+  const priorDirectTools = process.env.MCP_DIRECT_TOOLS;
+  process.env.HOME = root;
+  process.env.PI_CODING_AGENT_DIR = agentDir;
+  if (scenario === "direct-lazy") delete process.env.MCP_DIRECT_TOOLS;
+  else process.env.MCP_DIRECT_TOOLS = "__none__";
+  t.after(async () => {
+    if (priorHome === undefined) delete process.env.HOME;
+    else process.env.HOME = priorHome;
+    if (priorAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = priorAgentDir;
+    if (priorDirectTools === undefined) delete process.env.MCP_DIRECT_TOOLS;
+    else process.env.MCP_DIRECT_TOOLS = priorDirectTools;
+    await rm(root, { recursive: true, force: true });
+  });
+
+  const sdkEntrypoint = import.meta.resolve("@earendil-works/pi-coding-agent");
+  const sdkLoader = new URL("./core/extensions/loader.js", sdkEntrypoint).href;
+  const interactionsEntrypoint = import.meta.resolve("@kkkiio/pi-web-ui/interactions/v1");
+  const panelsModule = new URL("./panels.ts", interactionsEntrypoint).href;
+  const [index, sdk, loader, panelApi] = await Promise.all([
+    import("./index.ts"),
+    import("@earendil-works/pi-coding-agent"),
+    import(sdkLoader),
+    import(panelsModule),
+  ]);
+  const { McpServerManager } = await import("./server-manager.ts");
+  let connectionAttempts = 0;
+  t.mock.method(McpServerManager.prototype, "connect", async () => {
+    connectionAttempts++;
+    throw new Error("A deferred server must not be connected during panel startup");
+  });
+  const managers = new Set<unknown>();
+  const setMetadataListener = McpServerManager.prototype.setMetadataListChangedListener;
+  t.mock.method(McpServerManager.prototype, "setMetadataListChangedListener", function (this: any, ...args: any[]) {
+    managers.add(this);
+    return setMetadataListener.apply(this, args as any);
+  });
+
+  const events = sdk.createEventBus();
+  const panels = new panelApi.InteractionPanels();
+  const uninstallPanels = panelApi.installInteractionPanels(events, panels);
+  const runtime = loader.createExtensionRuntime();
+  // The factory loader leaves runner actions unbound; this isolated session
+  // has an empty Pi tool catalog and never submits model work.
+  runtime.getAllTools = () => [];
+  runtime.getActiveTools = () => [];
+  runtime.setActiveTools = () => {};
+  const extension = await loader.loadExtensionFromFactory(
+    index.default,
+    projectDir,
+    events,
+    runtime,
+    "pi-mcp-adapter:index-acceptance",
+  );
+  t.after(() => {
+    runtime.invalidate("MCP index acceptance finished");
+    uninstallPanels();
+    panels.close();
+    events.clear();
+  });
+
+  assert.equal(extension.commands.has("mcp-adapter"), true);
+  assert.equal(extension.commands.has("mcp-auth"), true);
+  assert.equal(extension.commands.has("mcp"), true);
+
+  const sessionManager = sdk.SessionManager.inMemory(projectDir);
+  const context = {
+    cwd: projectDir,
+    mode: "print",
+    hasUI: false,
+    ui: {
+      notify: () => {},
+      setStatus: () => {},
+      setWidget: () => {},
+    },
+    sessionManager,
+    modelRegistry: {
+      getApiKeyForProvider: async () => undefined,
+      getAvailable: () => [],
+      find: () => undefined,
+    },
+    model: undefined,
+    scopedModels: [],
+    thinkingLevel: "off",
+    isIdle: () => true,
+    isProjectTrusted: () => false,
+    signal: undefined,
+    abort: () => {},
+    hasPendingMessages: () => false,
+    shutdown: () => {},
+    getContextUsage: () => undefined,
+    compact: () => {},
+    getSystemPrompt: () => "",
+  } as any;
+
+  for (const handler of extension.handlers.get("session_start") ?? []) {
+    const started = handler({ type: "session_start" }, context);
+    if (scenario === "concurrent") {
+      // The session cleanup yields before exposing sessionCtx; the optional
+      // API import then yields again. An ordinary runtime event can arrive here.
+      for (let step = 0; step < 8; step++) await Promise.resolve();
+      const request: any = { version: 1, tool: "missing-acceptance-tool", args: {} };
+      events.emit(index.MCP_RUNTIME_TOOL_CALL_EVENT, request);
+      assert.ok(request.result, "the runtime request must be handled");
+      const result = await request.result;
+      assert.equal(result.ok, false);
+      assert.doesNotMatch(result.error.message, /stale_first_operation|active Pi session|not initialized/i);
+    }
+    await started;
+  }
+  await waitFor(
+    () => panels.list().some((manifest) => manifest.id === "pi-mcp-adapter"),
+    "MCP source panel was not registered after session_start",
+  );
+
+  assert.deepEqual(panels.list(), [{
+    id: "pi-mcp-adapter",
+    version: "6.0.0",
+    packageName: "pi-mcp-adapter",
+    commands: ["mcp-adapter", "mcp-auth", "mcp"],
+    methods: ["reconnect", "enable", "disable", "oauth"],
+  }]);
+  const snapshot = await panels.snapshot("pi-mcp-adapter");
+  assert.equal(connectionAttempts, 0, "panel startup must preserve deferred lazy discovery");
+  assert.equal(managers.size, 1, "concurrent startup must share one runtime initialization");
+  const enabled = snapshot.items.filter((item: any) => item.name === "enabled-lazy");
+  if (scenario === "lazy" || scenario === "direct-lazy") {
+    assert.equal(enabled.length, 1);
+    assert.equal(enabled[0].disabled, false);
+    assert.equal(enabled[0].listenState, "disconnected");
+  }
+  assert.deepEqual(snapshot.items.filter((item: any) => item.name !== "enabled-lazy"), [{
+    name: "disabled-acceptance",
+    status: "disabled",
+    listenState: "disconnected",
+    toolCount: 0,
+    directToolCount: 0,
+    disabled: true,
+  }]);
+  assert.deepEqual(snapshot.config, {
+    ownsMcpCommand: true,
+    programmaticConfig: false,
+    totalTools: 0,
+    totalResources: 0,
+    connectedCount: 0,
+    disabledCount: 1,
+  });
+
+  const action = panels.prepare("pi-mcp-adapter", {
+    registrationId: snapshot.registrationId,
+    revision: snapshot.revision,
+    method: "reconnect",
+    params: { name: "disabled-acceptance" },
+  });
+  panels.start("pi-mcp-adapter", action);
+  await waitFor(
+    () => panels.actionStatus("pi-mcp-adapter", action.actionId).state !== "pending",
+    "MCP source panel invoke did not settle",
+  );
+  assert.deepEqual(panels.actionStatus("pi-mcp-adapter", action.actionId), {
+    actionId: action.actionId,
+    state: "succeeded",
+    outcome: { ok: false, cancelled: true },
+  });
+
+  for (const handler of extension.handlers.get("session_shutdown") ?? []) {
+    await handler({ type: "session_shutdown" }, context);
+  }
+  assert.deepEqual(panels.list(), []);
+});
+}
