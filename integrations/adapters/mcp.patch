+import assert from "node:assert/strict"
+import { createHash } from "node:crypto"
+import { createServer, type IncomingMessage, type ServerResponse } from "node:http"
+import test from "node:test"
+
+type ObservedTokenRequest = {
+  code: string
+  codeVerifier: string
+  redirectUri: string
+  clientId: string
+}
+
+function json(res: ServerResponse, status: number, value: unknown): void {
+  res.writeHead(status, { "content-type": "application/json" })
+  res.end(JSON.stringify(value))
+}
+
+async function requestBody(req: IncomingMessage): Promise<string> {
+  const chunks: Buffer[] = []
+  for await (const chunk of req) chunks.push(Buffer.from(chunk))
+  return Buffer.concat(chunks).toString("utf8")
+}
+
+test("real OAuth flow rejects a wrong state and exchanges the callback code with the matching PKCE verifier", async (t) => {
+  process.env.PI_MCP_ADAPTER_TEST_AUTH_STORE = "memory"
+  process.env.PI_MCP_ADAPTER_DISABLE_AUTH_CACHE = "1"
+
+  const serverName = `oauth-acceptance-${process.pid}-${Date.now()}`
+  const authorizationCode = "synthetic-authorization-code"
+  const accessToken = "synthetic-access-token"
+  let origin = ""
+  let serverUrl = ""
+  let observedTokenRequest: ObservedTokenRequest | undefined
+
+  const provider = createServer(async (req, res) => {
+    const url = new URL(req.url ?? "/", origin)
+    if (req.method === "POST" && url.pathname === "/mcp") {
+      res.writeHead(401, {
+        "content-type": "application/json",
+        "www-authenticate": `Bearer resource_metadata="${origin}/resource-metadata", scope="mcp.read"`,
+      })
+      res.end(JSON.stringify({ error: "unauthorized" }))
+      return
+    }
+    if (req.method === "GET" && url.pathname === "/resource-metadata") {
+      json(res, 200, {
+        resource: serverUrl,
+        authorization_servers: [origin],
+        scopes_supported: ["mcp.read"],
+      })
+      return
+    }
+    if (req.method === "GET" && url.pathname === "/.well-known/oauth-authorization-server") {
+      json(res, 200, {
+        issuer: origin,
+        authorization_endpoint: `${origin}/authorize`,
+        token_endpoint: `${origin}/token`,
+        response_types_supported: ["code"],
+        grant_types_supported: ["authorization_code"],
+        code_challenge_methods_supported: ["S256"],
+        token_endpoint_auth_methods_supported: ["none"],
+        scopes_supported: ["mcp.read"],
+        authorization_response_iss_parameter_supported: true,
+      })
+      return
+    }
+    if (req.method === "POST" && url.pathname === "/token") {
+      const form = new URLSearchParams(await requestBody(req))
+      observedTokenRequest = {
+        code: form.get("code") ?? "",
+        codeVerifier: form.get("code_verifier") ?? "",
+        redirectUri: form.get("redirect_uri") ?? "",
+        clientId: form.get("client_id") ?? "",
+      }
+      json(res, 200, {
+        access_token: accessToken,
+        token_type: "Bearer",
+        expires_in: 3600,
+        scope: "mcp.read",
+      })
+      return
+    }
+    res.writeHead(404)
+    res.end()
+  })
+
+  await new Promise<void>((resolve, reject) => {
+    provider.once("error", reject)
+    provider.listen(0, "127.0.0.1", resolve)
+  })
+  const address = provider.address()
+  assert(address && typeof address === "object")
+  origin = `http://127.0.0.1:${address.port}`
+  serverUrl = `${origin}/mcp`
+
+  t.after(async () => {
+    await new Promise<void>((resolve) => provider.close(() => resolve()))
+  })
+
+  const auth = await import("./mcp-auth.ts")
+  const flow = await import("./mcp-auth-flow.ts")
+  const callback = await import("./mcp-callback-server.ts")
+  const runtime = flow.createOAuthRuntime()
+  auth.resetTestAuthSecretStore()
+  auth.resetAuthEntryCache()
+
+  t.after(async () => {
+    await flow.shutdownOAuth(runtime).catch(() => {})
+    await callback.stopCallbackServer().catch(() => {})
+    auth.resetTestAuthSecretStore()
+    delete process.env.PI_MCP_ADAPTER_TEST_AUTH_STORE
+    delete process.env.PI_MCP_ADAPTER_DISABLE_AUTH_CACHE
+  })
+
+  let authorizationState = ""
+  let authorizationChallenge = ""
+  let authorizationRedirectUri = ""
+  const status = await flow.authenticate(
+    serverName,
+    serverUrl,
+    {
+      url: serverUrl,
+      auth: "oauth",
+      oauth: {
+        clientId: "synthetic-public-client",
+        scope: "mcp.read",
+        redirectUri: "http://127.0.0.1:{port}/callback",
+      },
+    },
+    {
+      runtime,
+      openAuthorizationUrl: async () => {},
+      onAuthorizationUrl: async (value) => {
+        const authorizationUrl = new URL(value)
+        assert.equal(authorizationUrl.origin, origin)
+        assert.equal(authorizationUrl.pathname, "/authorize")
+        assert.equal(authorizationUrl.searchParams.get("response_type"), "code")
+        assert.equal(authorizationUrl.searchParams.get("client_id"), "synthetic-public-client")
+        assert.equal(authorizationUrl.searchParams.get("code_challenge_method"), "S256")
+        authorizationState = authorizationUrl.searchParams.get("state") ?? ""
+        authorizationChallenge = authorizationUrl.searchParams.get("code_challenge") ?? ""
+        authorizationRedirectUri = authorizationUrl.searchParams.get("redirect_uri") ?? ""
+        assert.match(authorizationState, /^[a-f0-9]{64}$/)
+        assert.match(authorizationChallenge, /^[A-Za-z0-9_-]{43}$/)
+
+        const wrongState = new URL(authorizationRedirectUri)
+        wrongState.searchParams.set("code", "wrong-state-code")
+        wrongState.searchParams.set("state", `${authorizationState}-wrong`)
+        wrongState.searchParams.set("iss", origin)
+        const rejected = await fetch(wrongState)
+        assert.equal(rejected.status, 400)
+
+        const accepted = new URL(authorizationRedirectUri)
+        accepted.searchParams.set("code", authorizationCode)
+        accepted.searchParams.set("state", authorizationState)
+        accepted.searchParams.set("iss", origin)
+        const response = await fetch(accepted)
+        assert.equal(response.status, 200)
+      },
+    },
+  )
+
+  assert.equal(status, "authenticated")
+  assert(observedTokenRequest)
+  assert.equal(observedTokenRequest.code, authorizationCode)
+  assert.equal(observedTokenRequest.redirectUri, authorizationRedirectUri)
+  assert.equal(observedTokenRequest.clientId, "synthetic-public-client")
+  assert.ok(observedTokenRequest.codeVerifier.length >= 43)
+  assert.equal(
+    createHash("sha256").update(observedTokenRequest.codeVerifier).digest("base64url"),
+    authorizationChallenge,
+  )
+
+  const stored = auth.getAuthForUrl(serverName, serverUrl)
+  assert.equal(stored?.tokens?.accessToken, accessToken)
+  assert.equal(stored?.tokens?.scope, "mcp.read")
+  assert.equal(stored?.codeVerifier, undefined)
+  assert.equal(stored?.oauthState, undefined)
+})
