+import assert from 'node:assert/strict';
+import { mkdir, mkdtemp, rm, stat, utimes } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { createEventBus } from '@earendil-works/pi-coding-agent';
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from '@earendil-works/pi-coding-agent';
+import type { InteractionClient, InteractionResult, InteractionSpec, SourceRequestOptions } from '@kkkiio/pi-web-ui/interactions/v1';
+import { registerScopedMemory } from '../src/pi/index.ts';
+import { FileStore } from '../src/storage/file-store.ts';
+import { createOptionalInteractionRunner } from '../src/pi/web-interactions.ts';
+
+type RegisteredTool = ToolDefinition<Record<string, unknown>, unknown>;
+
+const runnerManifest = {
+  id: 'scoped-memory-test',
+  version: '1',
+  packageName: 'scoped-memory-test',
+  actions: { confirm: { classification: 'sensitive' as const, method: 'confirm' as const } },
+};
+const runnerEvents = { emit() {}, on() { return () => {}; } };
+const pendingConfirm = (deadline: number): InteractionSpec => ({
+  action: 'confirm',
+  revision: 'runner-test-v1',
+  classification: 'sensitive',
+  method: 'confirm',
+  schema: { kind: 'confirm' },
+  content: { title: 'runner test' },
+  deadline,
+});
+
+function scriptedClient(
+  run: (spec: InteractionSpec, options: SourceRequestOptions) => Promise<InteractionResult>,
+): InteractionClient {
+  return {
+    status: () => 'available',
+    interact: run,
+    request: () => {
+      throw new Error('request() is not used by the scoped-memory adapter');
+    },
+    dispose() {},
+  };
+}
+
+function harness(
+  root: string,
+  confirm: ExtensionContext['ui']['confirm'],
+  interactions?: InteractionClient,
+) {
+  const tools = new Map<string, RegisteredTool>();
+  const handlers = new Map<string, Array<(event: unknown, ctx: ExtensionContext) => unknown>>();
+  const pi = {
+    events: createEventBus(),
+    getAllTools: () => [...tools.values()].map((tool) => ({ name: tool.name })),
+    registerTool(tool: RegisteredTool) { tools.set(tool.name, tool); },
+    registerCommand() {},
+    on(name: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {
+      handlers.set(name, [...(handlers.get(name) ?? []), handler]);
+    },
+  } as unknown as ExtensionAPI;
+  registerScopedMemory(pi, {
+    agentDir: join(root, 'agent'),
+    configDir: 'config',
+    identity: { workspaceId: 'fixture', workspaceRoot: root, mountinfo: '' },
+    ...(interactions ? { interactions } : {}),
+  });
+  const ctx = {
+    cwd: root,
+    hasUI: true,
+    isProjectTrusted: () => true,
+    sessionManager: {
+      getSessionId: () => 'session-fixture',
+      getSessionFile: () => join(root, 'session.jsonl'),
+      getBranch: () => [],
+      getEntries: () => [],
+      getLeafId: () => null,
+    },
+    ui: { confirm, notify() {}, setStatus() {} },
+  } as unknown as ExtensionContext;
+  return {
+    tools,
+    ctx,
+    async advance(name: string) {
+      for (const handler of handlers.get(name) ?? []) await handler({}, ctx);
+    },
+  };
+}
+
+async function invoke(
+  tools: Map<string, RegisteredTool>,
+  name: string,
+  params: Record<string, unknown>,
+  ctx: ExtensionContext,
+) {
+  const tool = tools.get(name);
+  assert.ok(tool, name);
+  return tool.execute('fixture-call', params, undefined, undefined, ctx as never) as Promise<{
+    details: Record<string, unknown>;
+  }>;
+}
+
+test('Web approval aborts the local memory dialog and commits the original prepared mutation once', async (t) => {
+  const root = await mkdtemp(join(tmpdir(), 'scoped-memory-web-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await mkdir(join(root, 'agent'), { mode: 0o700 });
+  let localStarted = false;
+  let localAborted = false;
+  let request: InteractionSpec | undefined;
+  const interactions = scriptedClient(async (spec, options) => {
+    request = structuredClone(spec);
+    assert.equal(options.isCurrent(), true);
+    assert.ok(options.local);
+    const controller = new AbortController();
+    const local = options.local(controller.signal);
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    controller.abort();
+    await local;
+    return { state: 'allowed', answer: true, winner: 'web' };
+  });
+  const { tools, ctx } = harness(root, async (_title, _message, options) => {
+    localStarted = true;
+    return new Promise<boolean>((resolve) => {
+      const timer = setTimeout(() => resolve(false), 50);
+      options?.signal?.addEventListener('abort', () => {
+        clearTimeout(timer);
+        localAborted = true;
+        resolve(false);
+      }, { once: true });
+    });
+  }, interactions);
+
+  const saved = await invoke(tools, 'scoped_memory_write', { scope: 'folder', text: 'remember exact fixture' }, ctx);
+  assert.equal(saved.details.status, 'saved');
+  assert.equal(localStarted, true);
+  assert.equal(localAborted, true);
+  assert.equal(request?.action, 'write');
+  assert.equal(request?.classification, 'sensitive');
+  assert.equal(request?.method, 'confirm');
+  assert.match(String(request?.revision), /^memory-v1:/);
+  assert.match(JSON.stringify(request?.content), /remember exact fixture/);
+
+  const read = await invoke(tools, 'scoped_memory_read', { scope: 'folder' }, ctx);
+  const records = read.details.records as Array<{ text: string }>;
+  assert.deepEqual(records.map((record) => record.text), ['remember exact fixture']);
+});
+
+test('missing optional Web package fallback cancels a non-returning local prompt on source abort', async () => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  const source = new AbortController();
+  let localSignal: AbortSignal | undefined;
+  const pending = runner.interact(pendingConfirm(Date.now() + 1_000), {
+    signal: source.signal,
+    isCurrent: () => true,
+    local: async (signal) => {
+      localSignal = signal;
+      return new Promise<boolean>(() => {});
+    },
+  });
+  await new Promise<void>((resolve) => setImmediate(resolve));
+  source.abort();
+  const result = await Promise.race([
+    pending,
+    new Promise<never>((_resolve, reject) => setTimeout(() => reject(new Error('fallback cancellation hung')), 250)),
+  ]);
+  assert.equal(result.state, 'cancelled');
+  assert.equal(localSignal?.aborted, true);
+});
+
+test('missing optional Web package fallback expires and aborts a non-returning local prompt at the absolute deadline', async () => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  let localSignal: AbortSignal | undefined;
+  const result = await Promise.race([
+    runner.interact(pendingConfirm(Date.now() + 25), {
+      isCurrent: () => true,
+      local: async (signal) => {
+        localSignal = signal;
+        return new Promise<boolean>(() => {});
+      },
+    }),
+    new Promise<never>((_resolve, reject) => setTimeout(() => reject(new Error('fallback deadline hung')), 500)),
+  ]);
+  assert.equal(result.state, 'expired');
+  assert.equal(localSignal?.aborted, true);
+});
+
+test('fallback source abort queued after currentness check prevents the local prompt from starting', async () => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  const source = new AbortController();
+  let localCalls = 0;
+  const result = await runner.interact(pendingConfirm(Date.now() + 1_000), {
+    signal: source.signal,
+    isCurrent: () => {
+      queueMicrotask(() => source.abort());
+      return true;
+    },
+    local: async () => {
+      localCalls++;
+      return true;
+    },
+  });
+  assert.equal(result.state, 'cancelled');
+  assert.equal(localCalls, 0);
+});
+
+test('fallback runner disposal queued after currentness check prevents the local prompt from starting', async () => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  let localCalls = 0;
+  const result = await runner.interact(pendingConfirm(Date.now() + 1_000), {
+    isCurrent: () => {
+      queueMicrotask(() => runner.dispose());
+      return true;
+    },
+    local: async () => {
+      localCalls++;
+      return true;
+    },
+  });
+  assert.equal(result.state, 'cancelled');
+  assert.equal(localCalls, 0);
+});
+
+test('fallback stale transition queued after the initial check prevents the local prompt from starting', async () => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  let current = true;
+  let checks = 0;
+  let localCalls = 0;
+  const result = await runner.interact(pendingConfirm(Date.now() + 1_000), {
+    isCurrent: () => {
+      checks++;
+      if (checks === 1) queueMicrotask(() => { current = false; });
+      return current;
+    },
+    local: async () => {
+      localCalls++;
+      return true;
+    },
+  });
+  assert.equal(result.state, 'stale');
+  assert.equal(localCalls, 0);
+});
