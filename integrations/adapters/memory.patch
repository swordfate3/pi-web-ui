+test('session lifecycle invalidation fences an old prepared mutation and allows a fresh binding', async (t) => {
+  const root = await mkdtemp(join(tmpdir(), 'scoped-memory-web-lifecycle-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await mkdir(join(root, 'agent'), { mode: 0o700 });
+  let release!: () => void;
+  const held = new Promise<void>((resolve) => { release = resolve; });
+  let entered!: () => void;
+  const started = new Promise<void>((resolve) => { entered = resolve; });
+  let requests = 0;
+  const interactions = scriptedClient(async () => {
+    requests++;
+    if (requests === 1) {
+      entered();
+      await held;
+    }
+    return { state: 'allowed', answer: true, winner: 'web' };
+  });
+  const registration = harness(root, async () => {
+    assert.fail('the terminal dialog must not win this Web fixture');
+  }, interactions);
+  const old = invoke(registration.tools, 'scoped_memory_write', {
+    scope: 'folder',
+    text: 'old prepared mutation',
+  }, registration.ctx);
+  await started;
+  await registration.advance('session_before_switch');
+  release();
+  const oldResult = await old;
+  assert.notEqual(oldResult.details.status, 'saved');
+  assert.deepEqual((await invoke(registration.tools, 'scoped_memory_read', {
+    scope: 'folder',
+  }, registration.ctx)).details.records, []);
+
+  const fresh = await invoke(registration.tools, 'scoped_memory_write', {
+    scope: 'folder',
+    text: 'fresh binding mutation',
+  }, registration.ctx);
+  assert.equal(fresh.details.status, 'saved');
+  const records = (await invoke(registration.tools, 'scoped_memory_read', {
+    scope: 'folder',
+  }, registration.ctx)).details.records as Array<{ text: string }>;
+  assert.deepEqual(records.map((record) => record.text), ['fresh binding mutation']);
+});
