+test('a concurrent committed write makes an older approved preparation stale', async (t) => {
+  const root = await mkdtemp(join(tmpdir(), 'scoped-memory-web-stale-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await mkdir(join(root, 'agent'), { mode: 0o700 });
+  let release!: () => void;
+  const held = new Promise<void>((resolve) => { release = resolve; });
+  let entered!: () => void;
+  const started = new Promise<void>((resolve) => { entered = resolve; });
+  const first = harness(root, async () => {
+    assert.fail('the terminal dialog must not win this Web fixture');
+  }, scriptedClient(async () => {
+    entered();
+    await held;
+    return { state: 'allowed', answer: true, winner: 'web' };
+  }));
+  const second = harness(root, async () => {
+    assert.fail('the terminal dialog must not win this Web fixture');
+  }, scriptedClient(async () => ({ state: 'allowed', answer: true, winner: 'web' })));
+  const stale = invoke(first.tools, 'scoped_memory_write', {
+    scope: 'folder',
+    text: 'older approved preparation',
+  }, first.ctx);
+  await started;
+  const competing = await invoke(second.tools, 'scoped_memory_write', {
+    scope: 'folder',
+    text: 'newer committed preparation',
+  }, second.ctx);
+  assert.equal(competing.details.status, 'saved');
+  release();
+  const staleResult = await stale;
+  assert.equal(staleResult.details.status, 'rejected');
+  assert.equal(staleResult.details.code, 'REVISION_CONFLICT');
+  const records = (await invoke(first.tools, 'scoped_memory_read', {
+    scope: 'folder',
+  }, first.ctx)).details.records as Array<{ text: string }>;
+  assert.deepEqual(records.map((record) => record.text), ['newer committed preparation']);
+});
