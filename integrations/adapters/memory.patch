+test('fallback effective deadline reached before the queued prompt prevents local startup', async (t) => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  const nativeNow = Date.now;
+  let now = nativeNow();
+  Date.now = () => now;
+  t.after(() => { Date.now = nativeNow; });
+  let checks = 0;
+  let localCalls = 0;
+  const result = await runner.interact(pendingConfirm(now + 600_000), {
+    isCurrent: () => {
+      checks++;
+      if (checks === 1) queueMicrotask(() => { now += 120_001; });
+      return true;
+    },
+    local: async () => {
+      localCalls++;
+      return true;
+    },
+  });
+  assert.equal(result.state, 'expired');
+  assert.equal(localCalls, 0);
+});
+
+test('fallback completion after the capped effective deadline expires even when the source deadline is later', async (t) => {
+  const runner = createOptionalInteractionRunner(runnerEvents, runnerManifest);
+  const nativeNow = Date.now;
+  let now = nativeNow();
+  Date.now = () => now;
+  t.after(() => { Date.now = nativeNow; });
+  let release!: (answer: boolean) => void;
+  const held = new Promise<boolean>((resolve) => { release = resolve; });
+  let entered!: () => void;
+  const started = new Promise<void>((resolve) => { entered = resolve; });
+  let localSignal: AbortSignal | undefined;
+  const pending = runner.interact(pendingConfirm(now + 600_000), {
+    isCurrent: () => true,
+    local: async (signal) => {
+      localSignal = signal;
+      entered();
+      return held;
+    },
+  });
+  await started;
+  now += 120_001;
+  release(true);
+  const result = await pending;
+  assert.equal(result.state, 'expired');
+  assert.equal(localSignal?.aborted, true);
+});
