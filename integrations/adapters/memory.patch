+++ b/src/pi/web-interactions.ts
@@ -0,0 +1,146 @@
+import type {
+  AdapterManifest,
+  InteractionClient,
+  InteractionEventBus,
+  InteractionResult,
+  InteractionSpec,
+  SourceRequestOptions,
+} from '@kkkiio/pi-web-ui/interactions/v1';
+
+const PUBLIC_MODULE = '@kkkiio/pi-web-ui/interactions/v1';
+const INTERACTION_LIMITS = {
+  confirmationMs: 120_000,
+  oauthMs: 600_000,
+} as const;
+
+function missingOptionalModule(error: unknown): boolean {
+  const candidate = error as { code?: unknown; message?: unknown } | null;
+  return (candidate?.code === 'ERR_MODULE_NOT_FOUND' || candidate?.code === 'MODULE_NOT_FOUND')
+    && typeof candidate.message === 'string'
+    && candidate.message.includes('@kkkiio/pi-web-ui');
+}
+
+async function terminalFallback(
+  spec: InteractionSpec,
+  options: SourceRequestOptions,
+  fallbacks: Map<AbortController, () => void>,
+  isDisposed: () => boolean,
+): Promise<InteractionResult> {
+  if (!Number.isSafeInteger(spec.deadline)) throw new Error('Invalid interaction deadline');
+  if (spec.deadline <= Date.now()) return { state: 'expired' };
+  if (options.signal?.aborted) return { state: 'cancelled' };
+  if (!options.isCurrent()) return { state: 'stale' };
+  if (!options.local) return { state: 'cancelled' };
+  const effectiveDeadline = Math.min(
+    spec.deadline,
+    Date.now() + (spec.purpose === 'oauth' ? INTERACTION_LIMITS.oauthMs : INTERACTION_LIMITS.confirmationMs),
+  );
+  return new Promise<InteractionResult>((resolve) => {
+    const controller = new AbortController();
+    let settled = false;
+    const finish = (result: InteractionResult) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      fallbacks.delete(controller);
+      options.signal?.removeEventListener('abort', cancel);
+      controller.abort();
+      resolve(result);
+    };
+    const cancel = () => finish({ state: 'cancelled' });
+    const remaining = effectiveDeadline - Date.now();
+    const timer = setTimeout(() => finish({ state: 'expired' }), Math.max(1, remaining));
+    fallbacks.set(controller, cancel);
+    options.signal?.addEventListener('abort', cancel, { once: true });
+    if (options.signal?.aborted || isDisposed()) {
+      cancel();
+      return;
+    }
+    void Promise.resolve()
+      .then(() => {
+        if (settled || isDisposed() || controller.signal.aborted) return undefined;
+        if (!options.isCurrent()) {
+          finish({ state: 'stale' });
+          return undefined;
+        }
+        if (Date.now() >= effectiveDeadline) {
+          finish({ state: 'expired' });
+          return undefined;
+        }
+        return options.local?.(controller.signal);
+      })
+      .then((answer) => {
+        if (settled) return;
+        if (options.signal?.aborted || isDisposed()) {
+          cancel();
+          return;
+        }
+        if (!options.isCurrent()) {
+          finish({ state: 'stale' });
+          return;
+        }
+        if (Date.now() >= effectiveDeadline) {
+          finish({ state: 'expired' });
+          return;
+        }
+        if (answer === undefined) {
+          cancel();
+          return;
+        }
+        if (spec.schema.kind !== 'confirm' || typeof answer !== 'boolean') {
+          throw new Error('Invalid local interaction answer');
+        }
+        finish({
+          state: answer ? 'allowed' : 'rejected',
+          answer,
+          winner: 'local',
+        });
+      })
+      .catch(cancel);
+  });
+}
+
+export interface OptionalInteractionRunner {
+  interact(spec: InteractionSpec, options: SourceRequestOptions): Promise<InteractionResult>;
+  dispose(): void;
+}
+
+export function createOptionalInteractionRunner(
+  events: InteractionEventBus,
+  manifest: AdapterManifest,
+  injected?: InteractionClient,
+): OptionalInteractionRunner {
+  let client: InteractionClient | undefined = injected;
+  let loading: Promise<InteractionClient | undefined> | undefined;
+  let disposed = false;
+  const fallbacks = new Map<AbortController, () => void>();
+  const load = (): Promise<InteractionClient | undefined> => {
+    if (client) return Promise.resolve(client);
+    loading ??= import(PUBLIC_MODULE)
+      .then((module) => {
+        client = module.createInteractionClient(events, manifest);
+        return client;
+      })
+      .catch((error: unknown) => {
+        if (missingOptionalModule(error)) return undefined;
+        throw error;
+      });
+    return loading;
+  };
+  return {
+    async interact(spec, options) {
+      const available = await load();
+      if (disposed) return { state: 'cancelled' };
+      return available
+        ? available.interact(spec, options)
+        : terminalFallback(spec, options, fallbacks, () => disposed);
+    },
+    dispose() {
+      disposed = true;
+      for (const cancel of [...fallbacks.values()]) cancel();
+      if (client) client.dispose();
+      else void loading?.then((loaded) => loaded?.dispose());
+      client = undefined;
+    },
+  };
+}
