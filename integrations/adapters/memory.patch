+test('an active writer lock is reported without offering Web repair or removing it', async (t) => {
+  const root = await mkdtemp(join(tmpdir(), 'scoped-memory-web-active-lock-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const agent = join(root, 'agent');
+  await mkdir(agent, { mode: 0o700 });
+  const store = new FileStore(agent, ['memory'], 'global');
+  let release!: () => void;
+  const held = new Promise<void>((resolve) => { release = resolve; });
+  let entered!: () => void;
+  const started = new Promise<void>((resolve) => { entered = resolve; });
+  const holding = store.exclusive(async () => {
+    entered();
+    await held;
+  });
+  await started;
+  let requested = false;
+  const registration = harness(root, async () => {
+    assert.fail('an active lock must not reach terminal repair confirmation');
+  }, scriptedClient(async () => {
+    requested = true;
+    throw new Error('an active lock must not reach Web repair confirmation');
+  }));
+  try {
+    const result = await invoke(registration.tools, 'scoped_memory_repair_lock', {}, registration.ctx);
+    assert.equal(result.details.status, 'active');
+    assert.equal(result.details.changed, false);
+    assert.equal(requested, false);
+    assert.equal((await stat(join(agent, 'memory', '.memory.lock'))).isFile(), true);
+  } finally {
+    release();
+    await holding;
+  }
+});
