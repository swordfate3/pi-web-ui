{
  "name": "@kkkiio/pi-web-ui",
  "version": "1.0.1",
  "description": "Web UI for Pi coding agent — view and control your Pi session from the browser",
  "keywords": [
    "pi",
    "pi-package",
    "coding-agent",
    "web-ui"
  ],
  "author": "kkkiio",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swordfate3/pi-web-ui.git"
  },
  "pi": {
    "extensions": [
      "./extensions/mirror-server.ts"
    ]
  },
  "bin": {
    "pi-web-hub": "dist/hub/pi-web-hub.mjs"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build && node src/web/terminal/build.mjs && vite build --config vite.hub.config.ts && npm run build:runtime && node scripts/web-dist.mjs --write",
    "build:runtime": "node runtime/terminal/build.mjs",
    "verify:dist": "node scripts/web-dist.mjs",
    "test:unit": "node --import ./tests/register-ts.mjs --test tests/*.test.ts tests/*.test.mjs src/web/src/core/i18n.test.ts src/web/src/components/pi-web-ui/sidebar-tree.test.ts",
    "preview:web": "vite preview --host 127.0.0.1",
    "e2e:gen": "bddgen test -c e2e/playwright.config.ts",
    "e2e": "npm run build:web && npm run e2e:gen && playwright test -c e2e/playwright.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci:biome": "biome ci .",
    "prepare": "node scripts/web-dist.mjs --install",
    "prepack": "npm run build:web"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent@1.1.0": {
      "@earendil-works/pi-codemode": "1.1.0"
    }
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.193",
    "@biomejs/biome": "2.4.15",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@git-diff-view/react": "^0.1.6",
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/xterm": "6.0.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "playwright-bdd": "^9.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "use-stick-to-bottom": "^1.1.4",
    "vite": "^8.0.14",
    "zustand": "^5.0.14",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin/",
    "hub/",
    "runtime/terminal/broker.ts",
    "runtime/terminal/protocol.ts",
    "runtime/terminal/supervisor.py",
    "runtime/terminal/client.py",
    "runtime/terminal/build.mjs",
    "extensions/",
    "dist/",
    "public/",
    "docs/remote-access.md",
    "docs/hub.md",
    "scripts/web-dist.mjs",
    "scripts/stage-terminal-image.mjs",
    "docs/images/",
    "LICENSE",
    "README.md"
  ]
}
